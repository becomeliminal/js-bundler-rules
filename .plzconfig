[please]
version = >=17.27.0

[PluginDefinition]
Name = bundler

[PluginConfig "esbuild"]
ConfigKey = Esbuild
DefaultValue = ///bundler//third_party/js/esbuild:node_modules
Help = node_modules tree holding esbuild. Owned by this plugin rather than read from the consumer's lockfile, which is safe because esbuild has no plugin ecosystem whose versions have to agree with it. vite is the opposite case and is pinned by the consumer.
Inherit = true

[PluginConfig "esbuild_package"]
ConfigKey = EsbuildPackage
DefaultValue = esbuild
Help = npm package within that tree publishing the bundler.
Inherit = true

[PluginConfig "terser"]
ConfigKey = Terser
DefaultValue = ///bundler//third_party/js/terser:node_modules
Help = node_modules tree holding terser. Owned by this plugin for the same reason esbuild is: no plugin ecosystem to keep in step with a consumer's config.
Inherit = true

[PluginConfig "terser_package"]
ConfigKey = TerserPackage
DefaultValue = terser
Help = npm package within that tree publishing the minifier.
Inherit = true

[Plugin "js"]
Target = //plugins:js
; The toolchain belongs to the repo being built, so a consumer supplies its own.
NodeTool = //third_party/node:node|node
; This plugin's own fixtures resolve first-party libraries only; a repo using
; these rules points this at its own npm_link tree.
NodeModules =

[Plugin "ts"]
Target = //plugins:ts

[Plugin "node"]
Target = //plugins:node

[Plugin "go"]
Target = //plugins:go
gotool = ///js//third_party/go:gotool|go

; No [Parse] preloadsubincludes: that config ships to every consumer, so
; anything preloaded here becomes a requirement on any repo that parses a
; package of this plugin.
