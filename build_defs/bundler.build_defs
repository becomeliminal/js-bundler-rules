"""Bundlers for Please.

Layer 3, where a repo of JavaScript becomes something you can ship. Everything
below has already happened: node-rules provides the runtime, js-rules the
package graph and the rules for running a tool against it, ts-rules the
compiler. A bundler rule adds no new machinery -- it declares the right inputs,
runs a published CLI, and declares what comes out.

That is deliberate. The old js-rules embedded esbuild as a Go library so it
could intercept module resolution and rewrite first-party import paths, because
there was no node_modules for anything to resolve through. There is one now, so
esbuild's own resolver -- the same algorithm, maintained by the people who wrote
it -- does the whole job. The Go route also does not generalise: rollup, vite
and webpack are JavaScript, and a ruleset covering all of them needs one
mechanism, which is running the tool's own CLI against a real tree.
"""

subinclude("///js//build_defs:js")

# esbuild's own words for what it will emit a sourcemap as. Anything else is a
# typo, and esbuild reports it as an unknown flag long after the build has
# staged a tree.
_SOURCEMAPS = ["inline", "external", "linked", "both"]


def _checked(rule:str, name:str, sources:list, check):
    """Refuses to bundle TypeScript that nothing type-checks.

    Neither bundler reads types. vite transpiles with esbuild and esbuild strips
    them without looking, so a type error reaches the output having failed no
    build -- which makes a type check that nothing depends on decoration rather
    than a guarantee.

    Every other language's binary rule already works this way: go_binary cannot
    emit a binary from code that does not compile, and neither can cargo. The
    JavaScript convention agrees, it is just spelled in a package.json rather
    than in a build graph -- `tsc -b && vite build` is what vite's own React
    template ships, and a developer running `npm run build` experiences it as
    one thing.

    Aspect leaves this open: their esbuild example bundles an index.ts with
    nothing checking it. Their intended wiring puts a ts_project upstream, so
    the check gates because the JavaScript itself comes out of tsc -- which
    works for esbuild and cannot work for vite, whose plugins need the original
    .tsx. One mechanism for both beats two stories.

    The check stays a separate action: a type error is no reason to invalidate a
    bundle's cache, and a changed asset is no reason to type-check again. Only
    the edge between them is new.
    """
    typescript = [s for s in sources if s.endswith(".ts") or s.endswith(".tsx")]
    if not typescript:
        return []
    first = typescript[0]
    if check == None:
        fail(f"{rule} {name}: {first} is TypeScript and nothing checks it. " +
             "This bundler strips types without reading them, so a type error " +
             "here would reach the output having failed no build. Pass " +
             "check = \":typecheck\" naming a ts_check over these sources, or " +
             "check = False to say you meant it.")
    if check == False:
        return []
    return [check]


def esbuild_bundle(name:str, entry_point:str="", entry_points:list=[],
                   srcs:list=[], deps:list=[],
                   out:str="", out_dir:str="", out_css:str="",
                   platform:str="browser",
                   format:str="", target:str="", minify:bool=False,
                   sourcemap:str="", sources_content:bool=True,
                   metafile:bool=False,
                   splitting:bool=False, external:list=[],
                   define:dict={}, node_modules:str="", env:dict={},
                   tsconfig:str="", tsconfig_deps:list=[],
                   check=None, args:list=[], visibility:list=None,
                   test_only:bool&testonly=False, labels:list=[]):
    """A bundle produced by esbuild.

    Named arguments cover the flags that change what comes out -- `splitting`
    and `sourcemap` add files, `format` and `platform` change their contents --
    and everything else goes through `args`. The rule owns the flags its outputs
    depend on and does not let `args` override them, the same division
    ts_library draws.

    Args:
        name: Target name.
        entry_point: The file esbuild starts from, relative to this package.
                     Added to srcs, so it does not have to be listed twice.
        entry_points: Several entry points into one bundle graph, which is what
                      makes shared code shareable: two esbuild invocations would
                      each carry their own copy of a common import, where one
                      invocation with two entries splits it once. Requires
                      out_dir, since several entries cannot produce one file.
        srcs: Further files the bundle reads, such as CSS or assets imported by
              the sources.
        deps: js_library and ts_library targets the sources import by package
              name, and npm_repo targets.
        out: The bundled file, for a bundle that is one file. Declared, so a
             downstream target can depend on exactly it.
        out_css: The stylesheet esbuild emits when a source imports one,
                 declared as its own output so a downstream target can depend
                 on the CSS alone -- without this the only option is out_dir,
                 which is how //test/ts/esbuild/site ended up with a directory
                 for what is really two files.
        out_dir: The directory the bundle is written to, for a bundle that is
                 not one file. Required with splitting, and the only option once
                 anything content-hashes its filenames.
        platform: "browser", "node" or "neutral".
        format: "iife", "cjs" or "esm". Defaults to esbuild's own choice for the
                platform.
        target: Language target, e.g. "es2022" or "node22".
        minify: Minify the output.
        tsconfig: A tsconfig esbuild reads paths from. This is the one
                  tsconfig setting with demand of its own: a repo using path
                  aliases cannot bundle without it, because esbuild resolves
                  the alias, not node. Types in it are ignored -- esbuild
                  strips them without reading, which is what check is for.
        tsconfig_deps: The configs it extends -- files, or a ts_config
                       target, which carries its own chain.
        check: A ts_check target covering these sources, made a dependency of
               the bundle so the bundle cannot be produced while it fails.
               Required when any source is TypeScript; pass False to bundle
               unchecked TypeScript deliberately.
        sourcemap: One of inline, external, linked, both. Empty for none.
        sources_content: Embed the original sources in the sourcemap. On by
                         default, as esbuild has it -- but a public site
                         shipping its sourcemaps is shipping its source, so
                         turning this off is the difference between a map that
                         locates errors and one that also publishes the code.
        metafile: Emit esbuild's dependency analysis as <name>.meta.json, a
                  declared output. The input to every bundle-size tool, and to
                  any future size-budget check.
        splitting: Split shared code into chunks. esbuild supports this only for
                   esm, and only into a directory.
        external: Import paths left unbundled.
        define: Compile-time constant substitutions.
        node_modules: The tree the sources resolve through -- the application's
                      own third-party packages. Defaults to the NodeModules
                      config. esbuild itself is never in here: it comes from its
                      own tree, because an application that depends on vite
                      depends on esbuild, and one tree cannot hold two of them.
        env: Environment variables for the action.
        args: Further esbuild flags.
        visibility: Visibility specification.
        test_only: If True, only visible to test rules.
        labels: Additional labels.
    """
    if bool(entry_point) == bool(entry_points):
        fail(f"esbuild_bundle {name}: set exactly one of entry_point or entry_points")
    if entry_points and not out_dir:
        fail(f"esbuild_bundle {name}: several entry points cannot produce one file, so they need out_dir")
    if bool(out) == bool(out_dir):
        fail(f"esbuild_bundle {name}: set exactly one of out or out_dir")
    if out_css and not out:
        fail(f"esbuild_bundle {name}: out_css declares a sidecar of out; with out_dir the stylesheet already lands there")
    if splitting and not out_dir:
        fail(f"esbuild_bundle {name}: splitting writes several files, so it needs out_dir")
    if splitting and format != "esm":
        fail(f"esbuild_bundle {name}: esbuild only splits esm output, not `{format or 'the default'}`")
    if sourcemap and sourcemap not in _SOURCEMAPS:
        fail(f"esbuild_bundle {name}: sourcemap is one of {', '.join(_SOURCEMAPS)}, not `{sourcemap}`")

    entries = [entry_point] if entry_point else entry_points
    flags = entries + ["--bundle", f"--platform={platform}"]
    flags += [f"--outfile={out}"] if out else [f"--outdir={out_dir}"]
    if format:
        flags += [f"--format={format}"]
    if target:
        flags += [f"--target={target}"]
    if minify:
        flags += ["--minify"]
    if sourcemap:
        flags += [f"--sourcemap={sourcemap}"]
    if not sources_content:
        flags += ["--sources-content=false"]
    if metafile:
        flags += [f"--metafile={name}.meta.json"]
    if splitting:
        flags += ["--splitting"]
    if tsconfig:
        flags += [f"--tsconfig={tsconfig}"]
    # Files in the chain ride srcs, staged at their real paths, which is all
    # extends needs; a ts_config target rides deps, where transitive staging
    # brings its whole chain.
    tsconfig_dep_files = [t for t in tsconfig_deps if not t.startswith(":") and not t.startswith("//")]
    tsconfig_dep_targets = [t for t in tsconfig_deps if t.startswith(":") or t.startswith("//")]
    flags += [f"--external:{e}" for e in external]
    flags += [f"--define:{k}={v}" for k, v in sorted(define.items())]

    # A sourcemap that is not inlined is a second file, and an output esbuild
    # writes but the rule does not declare is one Please deletes.
    outs = [out] if out else []
    if out and sourcemap in ["external", "linked", "both"]:
        outs += [out + ".map"]
    if out_css:
        outs += [out_css]
        if sourcemap in ["external", "linked", "both"]:
            outs += [out_css + ".map"]
    if metafile:
        outs += [name + ".meta.json"]

    return js_run_binary(
        name = name,
        package = CONFIG.BUNDLER.ESBUILD_PACKAGE,
        # Two trees. The bundler is an npm package and so is everything it
        # bundles, and a tree cannot hold two entries claiming one name -- which
        # is not a corner case, since vite depends on esbuild, so any consumer
        # with vite already has one.
        tool_modules = CONFIG.BUNDLER.ESBUILD,
        deps = deps + tsconfig_dep_targets + _checked("esbuild_bundle", name, [entry_point] + srcs, check),
        node_modules = node_modules,
        srcs = entries + srcs + ([tsconfig] if tsconfig else []) + tsconfig_dep_files,
        outs = outs,
        out_dirs = [out_dir] if out_dir else [],
        args = flags + args,
        env = env,
        visibility = visibility,
        test_only = test_only,
        labels = labels + ["esbuild_bundle"],
    )


def rollup_bundle(name:str, srcs:list, deps:list=[], config:str="rollup.config.mjs",
                  config_deps:list=[], out_dir:str="dist", node_modules:str="",
                  env:dict={}, check=None, args:list=[], visibility:list=None,
                  test_only:bool&testonly=False, labels:list=[]):
    """A bundle produced by rollup.

    Rollup comes from the consumer's tree, for vite's reason rather than
    esbuild's: a rollup.config.mjs imports plugins, and a plugin has to match
    the rollup it is loaded into -- @rollup/plugin-node-resolve is not
    optional decoration but the thing that makes bare imports resolve at all,
    so any real config loads at least one. A plugin-owned rollup would
    silently mismatch whatever the consumer pinned.

    Nothing is passed that the config could also set, same as vite_bundle:
    the config file is the interface rollup's own users already know.

    One default worth knowing about rather than discovering: an import
    nothing resolves is a warning to rollup, not an error -- the bundle
    builds green carrying an external import that explodes at runtime. A
    config that wants the build to fail says so with onwarn, throwing on
    UNRESOLVED_IMPORT; the test fixture shows the shape.

    Args:
        name: Target name.
        srcs: Entry modules and everything else the build reads.
        deps: js_library and ts_library targets the sources import by package
              name, and npm_repo targets.
        config: The rollup config, relative to this package.
        config_deps: Anything the config imports. A rollup config is
                     JavaScript that can import anything, so the chain is
                     named here and staged at its real paths.
        out_dir: Where the config writes, matching output.dir -- or the
                 directory of output.file. Hoisted like vite_bundle's.
        node_modules: The tree the build resolves through, holding rollup and
                      the config's plugins.
        env: Environment variables for the action.
        check: A ts_check covering these sources; required when any source is
               TypeScript, False to bundle unchecked TypeScript deliberately.
        args: Further rollup flags.
        visibility: Visibility specification.
        test_only: If True, only visible to test rules.
        labels: Additional labels.
    """
    return js_run_binary(
        name = name,
        package = "rollup",
        bin = "rollup",
        deps = deps + _checked("rollup_bundle", name, [config] + srcs, check),
        node_modules = node_modules,
        srcs = [config] + srcs + config_deps,
        out_dirs = [out_dir],
        args = ["--config", config] + args,
        env = env,
        visibility = visibility,
        test_only = test_only,
        labels = labels + ["rollup_bundle"],
    )


def webpack_bundle(name:str, srcs:list, deps:list=[], config:str="webpack.config.js",
                   config_deps:list=[], out_dir:str="dist", node_modules:str="",
                   env:dict={}, check=None, args:list=[], visibility:list=None,
                   test_only:bool&testonly=False, labels:list=[]):
    """A bundle produced by webpack.

    Webpack comes from the consumer's tree for the strongest version of
    vite's reason: not just plugins but loaders, and both are resolved by the
    webpack they load into. The rule passes nothing the config could set.

    config_deps matters more here than anywhere. A webpack config is
    JavaScript that can require anything -- a shared banner, a helper that
    computes entry points, another config to merge -- and each of those files
    is an input the build genuinely reads. Please stages sources at their
    real paths, so naming them is the whole implementation.

    Unlike rollup, webpack fails the build on an unresolved import by
    default, so no onwarn recipe is needed here.

    Args:
        name: Target name.
        srcs: Entry modules and everything else the build reads.
        deps: js_library and ts_library targets the sources import by package
              name, and npm_repo targets.
        config: The webpack config, relative to this package. Its
                output.path should resolve against __dirname, which is this
                package's directory in the staged tree.
        config_deps: Every file the config requires, directly or through
                     what it requires.
        out_dir: Where the config writes, matching output.path's last
                 segment. Hoisted like vite_bundle's.
        node_modules: The tree the build resolves through, holding webpack,
                      webpack-cli, and the config's loaders and plugins.
        env: Environment variables for the action.
        check: A ts_check covering these sources; required when any source is
               TypeScript, False to bundle unchecked TypeScript deliberately.
        args: Further webpack flags.
        visibility: Visibility specification.
        test_only: If True, only visible to test rules.
        labels: Additional labels.
    """
    return js_run_binary(
        name = name,
        package = "webpack-cli",
        bin = "webpack-cli",
        deps = deps + _checked("webpack_bundle", name, [config] + srcs, check),
        node_modules = node_modules,
        srcs = [config] + srcs + config_deps,
        out_dirs = [out_dir],
        args = ["build", "--config", config] + args,
        env = env,
        visibility = visibility,
        test_only = test_only,
        labels = labels + ["webpack_bundle"],
    )


def terser_minified(name:str, srcs:list, compress:bool=True, mangle:bool=True,
                    node_modules:str="", args:list=[], visibility:list=None,
                    test_only:bool&testonly=False, labels:list=[]):
    """Minification as a separate pass over an existing bundle.

    The first rule here that consumes another bundler's output rather than
    sources, and the input shape follows from that: a bundle is one declared
    file, but a vite build is a directory of hashed names nobody can declare.
    So this takes both -- every .js, .mjs and .cjs among the staged inputs is
    minified, each at its own relative path under a directory named after the
    rule, and everything else is ignored rather than copied: this rule's
    output is minified code, not a second copy of an index.html.

    A directory output rather than hoisted files, deliberately: the obvious
    consumer minifies `:bundle` in the same package, and a hoisted bundle.js
    would collide with the very file it was made from.

    terser comes from this plugin's own tree, like esbuild and unlike vite:
    it has no plugin ecosystem whose versions must agree with a consumer's
    config, so the plugin owning the pin costs nobody anything. The Terser
    config key overrides it.

    Args:
        name: Target name, and the output directory's name.
        srcs: What to minify: bundle targets, or files. Directories are
              walked; non-JavaScript is skipped.
        compress: Apply terser's compressor. On by default; passing False
                  leaves only whatever `args` asks for.
        mangle: Shorten names. On by default for the same reason.
        node_modules: The tree holding terser, overriding the plugin's own.
        args: Further terser flags -- sourcemap options most usefully.
        visibility: Visibility specification.
        test_only: If True, only visible to test rules.
        labels: Additional labels.
    """
    if not srcs:
        fail(f"terser_minified {name}: srcs is empty, and an unquoted find would walk the whole staging dir")

    tool_tree = node_modules or CONFIG.BUNDLER.TERSER
    flags = " ".join((["--compress"] if compress else []) + (["--mangle"] if mangle else []) + args)
    pkg = package_name()
    strip = pkg + "/" if pkg else ""

    return build_rule(
        name = name,
        srcs = {
            "srcs": srcs,
            "tool": [tool_tree],
        },
        outs = [name],
        cmd = " && ".join([
            'PLEASE_JS=$(readlink -f "$TOOLS_PLEASE_JS")',
            'NODE=$(readlink -f "$TOOLS_NODE")',
            f'BIN=$(readlink -f "$("$PLEASE_JS" resolve-bin --tree "$SRCS_TOOL" --package {CONFIG.BUNDLER.TERSER_PACKAGE} --bin terser)")',
            'mkdir -p "$OUT"',
            'OUT_ABS=$(readlink -f "$OUT")',
            # Files and directories through one walk; find on a file yields the
            # file. The output must not be empty -- srcs that contain no
            # JavaScript mean the wrong thing was staged, and a silently empty
            # directory would let a consumer ship nothing.
            'MINIFIED=0',
            'for f in $(find $SRCS_SRCS -type f | grep -E "[.](js|mjs|cjs)$" | sort); do ' +
            f'rel="${{f#{strip}}}"; ' +
            'mkdir -p "$OUT_ABS/$(dirname "$rel")"; ' +
            f'"$NODE" "$BIN" "$f" {flags} -o "$OUT_ABS/$rel"; ' +
            'MINIFIED=$((MINIFIED + 1)); done',
            '[ "$MINIFIED" -gt 0 ] || { echo "terser_minified: no JavaScript among the staged srcs" >&2; exit 1; }',
        ]),
        tools = {
            "please_js": ["///js//tools/please_js"],
            "node": [CONFIG.JS.NODE_TOOL],
        },
        visibility = visibility,
        test_only = test_only,
        labels = labels + ["terser_minified"],
        building_description = "Minifying...",
    )


def vite_bundle(name:str, srcs:list, deps:list=[], config:str="vite.config.ts",
                config_deps:list=[], out_dir:str="dist", mode:str="",
                node_modules:str="", env:dict={}, check=None, args:list=[],
                visibility:list=None, test_only:bool&testonly=False,
                labels:list=[]):
    """A production build produced by vite.

    Unlike esbuild, vite comes from the *consumer's* tree rather than this
    plugin's. That asymmetry is the design and not an oversight: a
    vite.config.ts imports plugins, and a plugin has to match the vite major it
    is loaded into, so a plugin-owned vite would silently mismatch whatever
    @vitejs/plugin-react a consumer has pinned. esbuild has no such ecosystem,
    which is why this plugin can own that one.

    Nothing is passed to vite that its config could also set. The config file is
    the interface vite's own users already know, and a rule that half-overrode
    it would leave two places to look when the output is wrong.

    Bundles from sources rather than from ts_library output, because vite's
    plugins operate on the original .tsx -- Fast Refresh needs the component as
    written -- and vite strips types with esbuild without checking them. So this
    does not type-check, exactly as `tsc && vite build` does not: type-checking
    is a separate target, which is better anyway, since it is a different
    failure with a different cache key.

    Args:
        name: Target name.
        srcs: Everything the build reads: index.html, sources, styles, assets,
              and any .env file, which changes the output and so is an input.
        deps: js_library and ts_library targets the sources import by package
              name, and npm_repo targets.
        config: The vite config, relative to this package.
        config_deps: Anything the config imports or extends. Please stages srcs
                     at their real paths, so carrying the chain is the whole
                     implementation -- nothing is rewritten.
        out_dir: Where vite writes, matching build.outDir in the config.
        check: A ts_check target covering these sources, made a dependency of
               the bundle so the bundle cannot be produced while it fails.
               Required when any source is TypeScript; pass False to bundle
               unchecked TypeScript deliberately.
        mode: vite's --mode, which selects the .env files it loads.
        node_modules: The tree the build resolves through, holding vite itself.
                      Defaults to the NodeModules config.
        env: Environment variables for the action. Anything the config or the
             sources read from process.env has to come through here, or the
             build is not reproducible.
        args: Further vite flags.
        visibility: Visibility specification.
        test_only: If True, only visible to test rules.
        labels: Additional labels.
    """
    flags = ["build", "--config", config, "--outDir", out_dir]
    if mode:
        flags += ["--mode", mode]

    return js_run_binary(
        name = name,
        package = "vite",
        bin = "vite",
        deps = deps + _checked("vite_bundle", name, [config] + srcs, check),
        node_modules = node_modules,
        srcs = [config] + srcs + config_deps,
        # vite content-hashes filenames, so nothing here can be declared. Please
        # hoists a directory output's contents, so this target's outputs are
        # index.html and assets/, not a dist/.
        out_dirs = [out_dir],
        args = flags + args,
        env = env,
        visibility = visibility,
        test_only = test_only,
        labels = labels + ["vite_bundle"],
    )


def vitest_test(name:str, srcs:list, deps:list=[], data:list=[],
                config:str="vite.config.ts", config_deps:list=[],
                node_modules:str="", env:dict={}, args:list=[],
                visibility:list=None, labels:list=[],
                timeout:int=0, flaky:bool|int=0, size:str=None):
    """Tests run by vitest.

    Vitest is vite: the same config file, the same plugin pipeline, the same
    transform. A component tested here is transformed exactly as it will be
    bundled, which is why this shares vite_bundle's config rather than having
    one of its own -- point it at a different config and the thing under test is
    not the thing that ships. That coupling is also why this rule lives here
    rather than beside the other test runners.

    Like vite, it comes from the consumer's tree. A repo's tests import describe
    and expect from the vitest it pinned, and its config imports plugins that
    have to match.

    Each test is reported to Please by name rather than the file being one
    result. vitest writes JUnit natively, so unlike node's own runner there is
    nothing to convert.

    Args:
        name: Target name.
        srcs: Test files, and anything they import that is not a dep.
        deps: js_library and ts_library targets the tests import by package
              name, and npm_repo targets.
        data: Targets the tests read rather than import.
        config: The vite config, relative to this package. Shared with
                vite_bundle on purpose.
        config_deps: Anything the config imports or extends.
        node_modules: The tree the tests resolve through, which holds vitest.
        env: Environment variables for the run.
        args: Further vitest flags.
        visibility: Visibility specification.
        labels: Additional labels.
        timeout: Test timeout in seconds.
        flaky: True to mark the test flaky, or an integer for reruns.
        size: Test size.
    """
    return js_test(
        name = name,
        srcs = [config] + srcs + config_deps,
        deps = deps,
        data = data,
        node_modules = node_modules,
        runner = "vitest",
        # CI mode: a missing snapshot fails the test rather than being written.
        # Without it vitest creates the file in the sandbox, the run passes,
        # and the snapshot is discarded with the tmp dir -- a test that asserts
        # nothing and never says so. Writing snapshots is vitest_update's job,
        # the only one allowed to touch the source tree.
        env = {"CI": "true"} | env,
        runner_args = [
            # `run`, not the default: vitest watches otherwise, and a test that
            # never exits is not a test.
            "run",
            "--config", config,
            "--reporter=junit",
            "--outputFile=$RESULTS_FILE",
        ] + args,
        visibility = visibility,
        labels = labels + ["vitest"],
        timeout = timeout,
        flaky = flaky,
        size = size,
    )


def vitest_update(name:str, srcs:list, deps:list=[], config:str="vite.config.ts",
                  config_deps:list=[], node_modules:str="", env:dict={},
                  args:list=[], visibility:list=None, labels:list=[]):
    """Rewrites committed snapshots. `plz run` only.

    A separate target rather than a flag on the test, because it writes to the
    source tree -- the same shape as npm_update, and for the same reason: a
    snapshot is a source, reviewed and committed, and a build action can touch
    neither the network nor the sources. vitest_test refuses to write one (its
    CI mode makes a missing snapshot a failure); this is the one sanctioned way
    they change.

    The test files are symlinked from the repository rather than copied, and a
    wrapper config resolves each snapshot beside the file's real path -- so a
    rewritten snapshot, and an inline snapshot vitest edits into the test file
    itself, lands in the developer's tree, while vitest and everything the
    tests import still resolve through the node_modules Please assembled.

    Args:
        name: Target name.
        srcs: The same test files the vitest_test names.
        deps: The same deps the vitest_test names.
        config: The vite config, shared with the test on purpose: a snapshot
                written under one pipeline and asserted under another would
                not survive the round trip.
        config_deps: Anything the config imports or extends.
        node_modules: The tree the tests resolve through, which holds vitest.
        env: Environment variables for the run.
        args: Further vitest flags -- a test name filter, most usefully.
        visibility: Visibility specification.
        labels: Additional labels.
    """
    wrapper = genrule(
        name = tag(name, "config"),
        srcs = [config],
        outs = ["_update.config.mjs"],
        cmd = " && ".join([
            'echo "import { mergeConfig } from \'vite\';" > "$OUT"',
            'echo "import { realpathSync } from \'node:fs\';" >> "$OUT"',
            'echo "import { dirname, join, basename } from \'node:path\';" >> "$OUT"',
            'echo "import user from \'./$(basename $SRCS)\';" >> "$OUT"',
            'echo "const base = typeof user === \'function\'" >> "$OUT"',
            'echo "  ? await user({ command: \'serve\', mode: \'test\' })" >> "$OUT"',
            'echo "  : user;" >> "$OUT"',
            'echo "export default mergeConfig(base, {" >> "$OUT"',
            # The tests are symlinks into the repository; resolving them away
            # would put them somewhere with no node_modules beside them.
            'echo "  resolve: { preserveSymlinks: true }," >> "$OUT"',
            # The snapshot goes beside the file the developer edits, not beside
            # the symlink: realpath of the linked test is the source file, so
            # __snapshots__ is created in the repository, which is the point.
            'echo "  test: { resolveSnapshotPath: (t, ext) =>" >> "$OUT"',
            'echo "    join(dirname(realpathSync(t)), \'__snapshots__\', basename(t) + ext) }," >> "$OUT"',
            'echo "});" >> "$OUT"',
        ]),
    )

    return js_binary(
        name = name,
        # Copied config, linked tests: node loads a config by real path, so a
        # linked one would resolve its plugins from the source tree. The tests
        # must be links -- their real path is where the snapshots belong.
        srcs = [config, wrapper] + config_deps,
        link_srcs = srcs,
        deps = deps,
        node_modules = node_modules,
        runner = "vitest",
        runner_args = ["run", "--update", "--config", "_update.config.mjs"] + args,
        env = env,
        visibility = visibility,
        labels = labels + ["vitest_update"],
    )


def vite_dev(name:str, srcs:list, deps:list=[], config:str="vite.config.ts",
             config_deps:list=[], node_modules:str="", env:dict={},
             args:list=[], visibility:list=None, labels:list=[]):
    """A vite development server, for `plz run`.

    Deliberately not hermetic, and it cannot be: the whole job is reacting to
    files that change after the build. It is a run target and never a build
    action.

    Everything Please generates still lives in plz-out. The server runs there,
    and the sources are symlinked into it rather than node_modules being
    symlinked next to them -- which would write into the source tree, and would
    create exactly the stray node_modules js-rules warns about.

    Inverting it works because of two vite defaults rather than any trick here:
    resolve.preserveSymlinks is false, so a symlinked source resolves to its
    real path and a module's id is the file the developer edits; and
    server.watch.followSymlinks is chokidar's, which is true, so the watcher
    watches that real file. Vite therefore serves, resolves and hot-swaps real
    files while nothing outside plz-out is touched.

    What this gives that running vite by hand does not: Please assembles
    node_modules first, with first-party libraries overlaid. In a monorepo those
    packages exist in no hand-made tree.

    For a headless rebuild loop, `plz watch -r //app:bundle` is the right tool
    and this is not -- it restarts the process, which is exactly what this
    exists to avoid.

    Args:
        name: Target name.
        srcs: Everything the server reads: index.html, sources, styles, assets,
              and any .env file, which vite loads from its root.
        deps: js_library and ts_library targets the sources import by package
              name, and npm_repo targets.
        config: The vite config, relative to this package. The same one
                vite_bundle uses, so what runs in development is what ships.
        config_deps: Anything the config imports or extends.
        node_modules: The tree the server resolves through, holding vite.
        env: Environment variables for the server.
        args: Further vite flags.
        visibility: Visibility specification.
        labels: Additional labels.

    Port, proxy, host, allowedHosts and server.fs.allow are deliberately absent:
    they live in vite.config.ts, where a vite user already knows to put them.
    """
    # The rule chose a tree with no symlinks in it, so the rule supplies the
    # setting that tree needs, rather than leaving it in the consumer's config
    # where it would look like their choice. Wrapping rather than rewriting: the
    # config stays theirs and this adds one line to it.
    wrapper = genrule(
        name = tag(name, "config"),
        srcs = {"config": [config], "libs": deps},
        outs = ["_dev.config.mjs"],
        cmd = " && ".join([
            # The first-party packages, by name, from the same lib.jsons the
            # overlay reads. Two things must be told about each: the optimizer,
            # or the served module is a cached prebundle rather than the
            # developer's source; and the watcher, whose default is to ignore
            # everything under node_modules.
            'NAMES=$("$TOOLS_PLEASE_JS" packages --dir .)',
            "EXCLUDE=$(for n in $NAMES; do printf \"'%s',\" \"$n\"; done)",
            # The watcher prunes traversal at every directory the ignore
            # matches, so negating the package's contents is not enough: each
            # ancestor -- the scope directory and the package directory itself
            # -- must be negated too, or the walk never reaches the files the
            # deeper negation names.
            # One negation per ancestor, including node_modules itself: the
            # watcher vite bundles (chokidar 3) tests each directory against
            # the ignore and prunes traversal there, and it matches the bare
            # node_modules directory against its own **/node_modules/** default
            # -- so without the first negation the walk never starts, and
            # without the others it stops one level short of the files the
            # last pattern names. Every one was found by watching it fail.
            'IGNORE=$([ -n "$NAMES" ] && printf "\'!**/node_modules\',"; ' +
            "for n in $NAMES; do " +
            'case "$n" in @*/*) printf "\'!**/node_modules/%s\'," "${n%%/*}";; esac; ' +
            'printf "\'!**/node_modules/%s\'," "$n"; ' +
            'printf "\'!**/node_modules/%s/**\'," "$n"; done)',
            'echo "import { mergeConfig } from \'vite\';" > "$OUT"',
            'echo "import user from \'./$(basename $SRCS_CONFIG)\';" >> "$OUT"',
            'echo "const base = typeof user === \'function\'" >> "$OUT"',
            'echo "  ? await user({ command: \'serve\', mode: \'development\' })" >> "$OUT"',
            'echo "  : user;" >> "$OUT"',
            'echo "export default mergeConfig(base, {" >> "$OUT"',
            # Sources are symlinked in from the repository, and resolving those
            # links would put them somewhere with no node_modules beside them.
            'echo "  resolve: { preserveSymlinks: true }," >> "$OUT"',
            'echo "  optimizeDeps: { exclude: [$EXCLUDE] }," >> "$OUT"',
            'echo "  server: { watch: { ignored: [$IGNORE] } }," >> "$OUT"',
            'echo "});" >> "$OUT"',
        ]),
        tools = {"please_js": ["///js//tools/please_js"]},
    )

    return js_binary(
        name = name,
        # The config is copied, the sources are linked, and the difference is
        # not arbitrary: node loads a config by its real path, so a symlinked
        # one would resolve its own plugin imports from the source tree, where
        # there is no node_modules. It is read once at startup anyway. The
        # sources are read continuously and must be the developer's own files.
        srcs = [config, wrapper] + config_deps,
        link_srcs = srcs,
        deps = deps,
        node_modules = node_modules,
        link_deps = True,
        runner = "vite",
        # No subcommand: `vite` with no arguments is the dev server, and naming
        # it `dev` would be an alias for the same thing.
        runner_args = ["--config", "_dev.config.mjs"] + args,
        env = env,
        visibility = visibility,
        labels = labels + ["vite_dev"],
    )
