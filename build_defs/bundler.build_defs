"""Bundlers for Please.

Layer 3, where a repo of JavaScript becomes something you can ship. Everything
below has already happened: node-rules provides the runtime, js-rules the
package graph and the rules for running a tool against it, ts-rules the
compiler. A bundler rule adds no new machinery -- it declares the right inputs,
runs a published CLI, and declares what comes out.

That is deliberate. The old js-rules embedded esbuild as a Go library so it
could intercept module resolution and rewrite first-party import paths, because
there was no node_modules for anything to resolve through. There is one now, so
esbuild's own resolver -- the same algorithm, maintained by the people who wrote
it -- does the whole job. The Go route also does not generalise: rollup, vite
and webpack are JavaScript, and a ruleset covering all of them needs one
mechanism, which is running the tool's own CLI against a real tree.
"""

subinclude("///js//build_defs:js")

# esbuild's own words for what it will emit a sourcemap as. Anything else is a
# typo, and esbuild reports it as an unknown flag long after the build has
# staged a tree.
_SOURCEMAPS = ["inline", "external", "linked", "both"]


def _checked(rule:str, name:str, sources:list, check):
    """Refuses to bundle TypeScript that nothing type-checks.

    Neither bundler reads types. vite transpiles with esbuild and esbuild strips
    them without looking, so a type error reaches the output having failed no
    build -- which makes a type check that nothing depends on decoration rather
    than a guarantee.

    Every other language's binary rule already works this way: go_binary cannot
    emit a binary from code that does not compile, and neither can cargo. The
    JavaScript convention agrees, it is just spelled in a package.json rather
    than in a build graph -- `tsc -b && vite build` is what vite's own React
    template ships, and a developer running `npm run build` experiences it as
    one thing.

    Aspect leaves this open: their esbuild example bundles an index.ts with
    nothing checking it. Their intended wiring puts a ts_project upstream, so
    the check gates because the JavaScript itself comes out of tsc -- which
    works for esbuild and cannot work for vite, whose plugins need the original
    .tsx. One mechanism for both beats two stories.

    The check stays a separate action: a type error is no reason to invalidate a
    bundle's cache, and a changed asset is no reason to type-check again. Only
    the edge between them is new.
    """
    typescript = [s for s in sources if s.endswith(".ts") or s.endswith(".tsx")]
    if not typescript:
        return []
    first = typescript[0]
    if check == None:
        fail(f"{rule} {name}: {first} is TypeScript and nothing checks it. " +
             "This bundler strips types without reading them, so a type error " +
             "here would reach the output having failed no build. Pass " +
             "check = \":typecheck\" naming a ts_check over these sources, or " +
             "check = False to say you meant it.")
    if check == False:
        return []
    return [check]


def esbuild_bundle(name:str, entry_point:str="", entry_points:list=[],
                   srcs:list=[], deps:list=[],
                   out:str="", out_dir:str="", out_css:str="",
                   platform:str="browser",
                   format:str="", target:str="", minify:bool=False,
                   sourcemap:str="", sources_content:bool=True,
                   metafile:bool=False,
                   splitting:bool=False, external:list=[],
                   define:dict={}, node_modules:str="", env:dict={},
                   tsconfig:str="", tsconfig_deps:list=[],
                   check=None, args:list=[], visibility:list=None,
                   test_only:bool&testonly=False, labels:list=[]):
    """A bundle produced by esbuild.

    Named arguments cover the flags that change what comes out -- `splitting`
    and `sourcemap` add files, `format` and `platform` change their contents --
    and everything else goes through `args`. The rule owns the flags its outputs
    depend on and does not let `args` override them, the same division
    ts_library draws.

    Args:
        name: Target name.
        entry_point: The file esbuild starts from, relative to this package.
                     Added to srcs, so it does not have to be listed twice.
        entry_points: Several entry points into one bundle graph, which is what
                      makes shared code shareable: two esbuild invocations would
                      each carry their own copy of a common import, where one
                      invocation with two entries splits it once. Requires
                      out_dir, since several entries cannot produce one file.
        srcs: Further files the bundle reads, such as CSS or assets imported by
              the sources.
        deps: js_library and ts_library targets the sources import by package
              name, and npm_repo targets.
        out: The bundled file, for a bundle that is one file. Declared, so a
             downstream target can depend on exactly it.
        out_css: The stylesheet esbuild emits when a source imports one,
                 declared as its own output so a downstream target can depend
                 on the CSS alone -- without this the only option is out_dir,
                 which is how //test/ts/esbuild/site ended up with a directory
                 for what is really two files.
        out_dir: The directory the bundle is written to, for a bundle that is
                 not one file. Required with splitting, and the only option once
                 anything content-hashes its filenames.
        platform: "browser", "node" or "neutral".
        format: "iife", "cjs" or "esm". Defaults to esbuild's own choice for the
                platform.
        target: Language target, e.g. "es2022" or "node22".
        minify: Minify the output.
        tsconfig: A tsconfig esbuild reads paths from. This is the one
                  tsconfig setting with demand of its own: a repo using path
                  aliases cannot bundle without it, because esbuild resolves
                  the alias, not node. Types in it are ignored -- esbuild
                  strips them without reading, which is what check is for.
        tsconfig_deps: The configs it extends -- files, or a ts_config
                       target, which carries its own chain.
        check: A ts_check target covering these sources, made a dependency of
               the bundle so the bundle cannot be produced while it fails.
               Required when any source is TypeScript; pass False to bundle
               unchecked TypeScript deliberately.
        sourcemap: One of inline, external, linked, both. Empty for none.
        sources_content: Embed the original sources in the sourcemap. On by
                         default, as esbuild has it -- but a public site
                         shipping its sourcemaps is shipping its source, so
                         turning this off is the difference between a map that
                         locates errors and one that also publishes the code.
        metafile: Emit esbuild's dependency analysis as <name>.meta.json, a
                  declared output. The input to every bundle-size tool, and to
                  any future size-budget check.
        splitting: Split shared code into chunks. esbuild supports this only for
                   esm, and only into a directory.
        external: Import paths left unbundled.
        define: Compile-time constant substitutions.
        node_modules: The tree the sources resolve through -- the application's
                      own third-party packages. Defaults to the NodeModules
                      config. esbuild itself is never in here: it comes from its
                      own tree, because an application that depends on vite
                      depends on esbuild, and one tree cannot hold two of them.
        env: Environment variables for the action.
        args: Further esbuild flags.
        visibility: Visibility specification.
        test_only: If True, only visible to test rules.
        labels: Additional labels.
    """
    if bool(entry_point) == bool(entry_points):
        fail(f"esbuild_bundle {name}: set exactly one of entry_point or entry_points")
    if entry_points and not out_dir:
        fail(f"esbuild_bundle {name}: several entry points cannot produce one file, so they need out_dir")
    if bool(out) == bool(out_dir):
        fail(f"esbuild_bundle {name}: set exactly one of out or out_dir")
    if out_css and not out:
        fail(f"esbuild_bundle {name}: out_css declares a sidecar of out; with out_dir the stylesheet already lands there")
    if splitting and not out_dir:
        fail(f"esbuild_bundle {name}: splitting writes several files, so it needs out_dir")
    if splitting and format != "esm":
        fail(f"esbuild_bundle {name}: esbuild only splits esm output, not `{format or 'the default'}`")
    if sourcemap and sourcemap not in _SOURCEMAPS:
        fail(f"esbuild_bundle {name}: sourcemap is one of {', '.join(_SOURCEMAPS)}, not `{sourcemap}`")

    entries = [entry_point] if entry_point else entry_points
    flags = entries + ["--bundle", f"--platform={platform}"]
    flags += [f"--outfile={out}"] if out else [f"--outdir={out_dir}"]
    if format:
        flags += [f"--format={format}"]
    if target:
        flags += [f"--target={target}"]
    if minify:
        flags += ["--minify"]
    if sourcemap:
        flags += [f"--sourcemap={sourcemap}"]
    if not sources_content:
        flags += ["--sources-content=false"]
    if metafile:
        flags += [f"--metafile={name}.meta.json"]
    if splitting:
        flags += ["--splitting"]
    if tsconfig:
        flags += [f"--tsconfig={tsconfig}"]
    # Files in the chain ride srcs, staged at their real paths, which is all
    # extends needs; a ts_config target rides deps, where transitive staging
    # brings its whole chain.
    tsconfig_dep_files = [t for t in tsconfig_deps if not t.startswith(":") and not t.startswith("//")]
    tsconfig_dep_targets = [t for t in tsconfig_deps if t.startswith(":") or t.startswith("//")]
    flags += [f"--external:{e}" for e in external]
    flags += [f"--define:{k}={v}" for k, v in sorted(define.items())]

    # A sourcemap that is not inlined is a second file, and an output esbuild
    # writes but the rule does not declare is one Please deletes.
    outs = [out] if out else []
    if out and sourcemap in ["external", "linked", "both"]:
        outs += [out + ".map"]
    if out_css:
        outs += [out_css]
        if sourcemap in ["external", "linked", "both"]:
            outs += [out_css + ".map"]
    if metafile:
        outs += [name + ".meta.json"]

    return js_run_binary(
        name = name,
        package = CONFIG.BUNDLER.ESBUILD_PACKAGE,
        # Two trees. The bundler is an npm package and so is everything it
        # bundles, and a tree cannot hold two entries claiming one name -- which
        # is not a corner case, since vite depends on esbuild, so any consumer
        # with vite already has one.
        tool_modules = CONFIG.BUNDLER.ESBUILD,
        deps = deps + tsconfig_dep_targets + _checked("esbuild_bundle", name, [entry_point] + srcs, check),
        node_modules = node_modules,
        srcs = entries + srcs + ([tsconfig] if tsconfig else []) + tsconfig_dep_files,
        outs = outs,
        out_dirs = [out_dir] if out_dir else [],
        args = flags + args,
        env = env,
        visibility = visibility,
        test_only = test_only,
        labels = labels + ["esbuild_bundle"],
    )


def rollup_bundle(name:str, srcs:list, deps:list=[], config:str="rollup.config.mjs",
                  config_deps:list=[], out_dir:str="dist", node_modules:str="",
                  env:dict={}, check=None, args:list=[], visibility:list=None,
                  test_only:bool&testonly=False, labels:list=[]):
    """A bundle produced by rollup.

    Rollup comes from the consumer's tree, for vite's reason rather than
    esbuild's: a rollup.config.mjs imports plugins, and a plugin has to match
    the rollup it is loaded into -- @rollup/plugin-node-resolve is not
    optional decoration but the thing that makes bare imports resolve at all,
    so any real config loads at least one. A plugin-owned rollup would
    silently mismatch whatever the consumer pinned.

    Nothing is passed that the config could also set, same as vite_bundle:
    the config file is the interface rollup's own users already know.

    One default worth knowing about rather than discovering: an import
    nothing resolves is a warning to rollup, not an error -- the bundle
    builds green carrying an external import that explodes at runtime. A
    config that wants the build to fail says so with onwarn, throwing on
    UNRESOLVED_IMPORT; the test fixture shows the shape.

    Args:
        name: Target name.
        srcs: Entry modules and everything else the build reads.
        deps: js_library and ts_library targets the sources import by package
              name, and npm_repo targets.
        config: The rollup config, relative to this package.
        config_deps: Anything the config imports. A rollup config is
                     JavaScript that can import anything, so the chain is
                     named here and staged at its real paths.
        out_dir: Where the config writes, matching output.dir -- or the
                 directory of output.file. Hoisted: the outputs are its
                 contents, at the package root, as the config decides
                 where it is.
        node_modules: The tree the build resolves through, holding rollup and
                      the config's plugins.
        env: Environment variables for the action.
        check: A ts_check covering these sources; required when any source is
               TypeScript, False to bundle unchecked TypeScript deliberately.
        args: Further rollup flags.
        visibility: Visibility specification.
        test_only: If True, only visible to test rules.
        labels: Additional labels.
    """
    return js_run_binary(
        name = name,
        package = "rollup",
        bin = "rollup",
        deps = deps + _checked("rollup_bundle", name, [config] + srcs, check),
        node_modules = node_modules,
        srcs = [config] + srcs + config_deps,
        out_dirs = [out_dir],
        args = ["--config", config] + args,
        env = env,
        visibility = visibility,
        test_only = test_only,
        labels = labels + ["rollup_bundle"],
    )


def webpack_bundle(name:str, srcs:list, deps:list=[], config:str="webpack.config.js",
                   config_deps:list=[], out_dir:str="dist", node_modules:str="",
                   env:dict={}, check=None, args:list=[], visibility:list=None,
                   test_only:bool&testonly=False, labels:list=[]):
    """A bundle produced by webpack.

    Webpack comes from the consumer's tree for the strongest version of
    vite's reason: not just plugins but loaders, and both are resolved by the
    webpack they load into. The rule passes nothing the config could set.

    config_deps matters more here than anywhere. A webpack config is
    JavaScript that can require anything -- a shared banner, a helper that
    computes entry points, another config to merge -- and each of those files
    is an input the build genuinely reads. Please stages sources at their
    real paths, so naming them is the whole implementation.

    Unlike rollup, webpack fails the build on an unresolved import by
    default, so no onwarn recipe is needed here.

    Args:
        name: Target name.
        srcs: Entry modules and everything else the build reads.
        deps: js_library and ts_library targets the sources import by package
              name, and npm_repo targets.
        config: The webpack config, relative to this package. Its
                output.path should resolve against __dirname, which is this
                package's directory in the staged tree.
        config_deps: Every file the config requires, directly or through
                     what it requires.
        out_dir: Where the config writes, matching output.path's last
                 segment. Hoisted: the outputs are its contents, at the
                 package root, as the config decides where it is.
        node_modules: The tree the build resolves through, holding webpack,
                      webpack-cli, and the config's loaders and plugins.
        env: Environment variables for the action.
        check: A ts_check covering these sources; required when any source is
               TypeScript, False to bundle unchecked TypeScript deliberately.
        args: Further webpack flags.
        visibility: Visibility specification.
        test_only: If True, only visible to test rules.
        labels: Additional labels.
    """
    return js_run_binary(
        name = name,
        package = "webpack-cli",
        bin = "webpack-cli",
        deps = deps + _checked("webpack_bundle", name, [config] + srcs, check),
        node_modules = node_modules,
        srcs = [config] + srcs + config_deps,
        out_dirs = [out_dir],
        args = ["build", "--config", config] + args,
        env = env,
        visibility = visibility,
        test_only = test_only,
        labels = labels + ["webpack_bundle"],
    )


def terser_minified(name:str, srcs:list, compress:bool=True, mangle:bool=True,
                    node_modules:str="", args:list=[], visibility:list=None,
                    test_only:bool&testonly=False, labels:list=[]):
    """Minification as a separate pass over an existing bundle.

    The first rule here that consumes another bundler's output rather than
    sources, and the input shape follows from that: a bundle is one declared
    file, but a vite build is a directory of hashed names nobody can declare.
    So this takes both -- every .js, .mjs and .cjs among the staged inputs is
    minified, each at its own relative path under a directory named after the
    rule, and everything else is ignored rather than copied: this rule's
    output is minified code, not a second copy of an index.html.

    A directory output rather than hoisted files, deliberately: the obvious
    consumer minifies `:bundle` in the same package, and a hoisted bundle.js
    would collide with the very file it was made from.

    terser comes from this plugin's own tree, like esbuild and unlike vite:
    it has no plugin ecosystem whose versions must agree with a consumer's
    config, so the plugin owning the pin costs nobody anything. The Terser
    config key overrides it.

    Args:
        name: Target name, and the output directory's name.
        srcs: What to minify: bundle targets, or files. Directories are
              walked; non-JavaScript is skipped.
        compress: Apply terser's compressor. On by default; passing False
                  leaves only whatever `args` asks for.
        mangle: Shorten names. On by default for the same reason.
        node_modules: The tree holding terser, overriding the plugin's own.
        args: Further terser flags -- sourcemap options most usefully.
        visibility: Visibility specification.
        test_only: If True, only visible to test rules.
        labels: Additional labels.
    """
    if not srcs:
        fail(f"terser_minified {name}: srcs is empty, and an unquoted find would walk the whole staging dir")

    tool_tree = node_modules or CONFIG.BUNDLER.TERSER
    flags = " ".join((["--compress"] if compress else []) + (["--mangle"] if mangle else []) + args)
    pkg = package_name()
    strip = pkg + "/" if pkg else ""

    return build_rule(
        name = name,
        srcs = {
            "srcs": srcs,
            "tool": [tool_tree],
        },
        outs = [name],
        cmd = " && ".join([
            'PLEASE_JS=$(readlink -f "$TOOLS_PLEASE_JS")',
            'NODE=$(readlink -f "$TOOLS_NODE")',
            f'BIN=$(readlink -f "$("$PLEASE_JS" resolve-bin --tree "$SRCS_TOOL" --package {CONFIG.BUNDLER.TERSER_PACKAGE} --bin terser)")',
            'mkdir -p "$OUT"',
            'OUT_ABS=$(readlink -f "$OUT")',
            # Files and directories through one walk; find on a file yields the
            # file. The output must not be empty -- srcs that contain no
            # JavaScript mean the wrong thing was staged, and a silently empty
            # directory would let a consumer ship nothing.
            'MINIFIED=0',
            'for f in $(find $SRCS_SRCS -type f | grep -E "[.](js|mjs|cjs)$" | sort); do ' +
            f'rel="${{f#{strip}}}"; ' +
            'mkdir -p "$OUT_ABS/$(dirname "$rel")"; ' +
            f'"$NODE" "$BIN" "$f" {flags} -o "$OUT_ABS/$rel"; ' +
            'MINIFIED=$((MINIFIED + 1)); done',
            '[ "$MINIFIED" -gt 0 ] || { echo "terser_minified: no JavaScript among the staged srcs" >&2; exit 1; }',
        ]),
        tools = {
            "please_js": ["///js//tools/please_js"],
            "node": [CONFIG.JS.NODE_TOOL],
        },
        visibility = visibility,
        test_only = test_only,
        labels = labels + ["terser_minified"],
        building_description = "Minifying...",
    )


def vite_bundle(name:str, srcs:list, deps:list=[], config:str="vite.config.ts",
                config_deps:list=[], out_dir:str="dist", mode:str="",
                node_modules:str="", env:dict={}, check=None, args:list=[],
                visibility:list=None, test_only:bool&testonly=False,
                labels:list=[]):
    """A production build produced by vite.

    Unlike esbuild, vite comes from the *consumer's* tree rather than this
    plugin's. That asymmetry is the design and not an oversight: a
    vite.config.ts imports plugins, and a plugin has to match the vite major it
    is loaded into, so a plugin-owned vite would silently mismatch whatever
    @vitejs/plugin-react a consumer has pinned. esbuild has no such ecosystem,
    which is why this plugin can own that one.

    Nothing is passed to vite that its config could also set. The config file is
    the interface vite's own users already know, and a rule that half-overrode
    it would leave two places to look when the output is wrong.

    Bundles from sources rather than from ts_library output, because vite's
    plugins operate on the original .tsx -- Fast Refresh needs the component as
    written -- and vite strips types with esbuild without checking them. So this
    does not type-check, exactly as `tsc && vite build` does not: type-checking
    is a separate target, which is better anyway, since it is a different
    failure with a different cache key.

    Args:
        name: Target name.
        srcs: Everything the build reads: index.html, sources, styles, assets,
              and any .env file, which changes the output and so is an input.
        deps: js_library and ts_library targets the sources import by package
              name, and npm_repo targets.
        config: The vite config, relative to this package.
        config_deps: Anything the config imports or extends. Please stages srcs
                     at their real paths, so carrying the chain is the whole
                     implementation -- nothing is rewritten.
        out_dir: The directory the build is, and the target's output: vite
                 writes it under a directory of this target's own, and that
                 one is hoisted, so the output is <out_dir>/ itself and not
                 its contents spilled into the package. Two builds in one
                 package -- a client and an SSR build -- then cannot collide
                 on assets/. Overrides build.outDir in the config.
        check: A ts_check target covering these sources, made a dependency of
               the bundle so the bundle cannot be produced while it fails.
               Required when any source is TypeScript; pass False to bundle
               unchecked TypeScript deliberately.
        mode: vite's --mode, which selects the .env files it loads.
        node_modules: The tree the build resolves through, holding vite itself.
                      Defaults to the NodeModules config.
        env: Environment variables for the action. Anything the config or the
             sources read from process.env has to come through here, or the
             build is not reproducible.
        args: Further vite flags.
        visibility: Visibility specification.
        test_only: If True, only visible to test rules.
        labels: Additional labels.
    """
    # Please hoists a directory output's contents into the package. Writing
    # the build one level down, under this target's own name, makes what is
    # hoisted the out_dir itself, which no other target in the package names.
    wrapper = f"_{name}"
    flags = ["build", "--config", config, "--outDir", f"{wrapper}/{out_dir}"]
    if mode:
        flags += ["--mode", mode]

    return js_run_binary(
        name = name,
        package = "vite",
        bin = "vite",
        deps = deps + _checked("vite_bundle", name, [config] + srcs, check),
        node_modules = node_modules,
        srcs = [config] + srcs + config_deps,
        # vite content-hashes filenames, so nothing here can be declared.
        out_dirs = [wrapper],
        args = flags + args,
        env = env,
        visibility = visibility,
        test_only = test_only,
        labels = labels + ["vite_bundle"],
    )


def vitest_test(name:str, srcs:list, deps:list=[], data:list=[],
                config:str="vite.config.ts", config_deps:list=[],
                node_modules:str="", env:dict={}, args:list=[],
                visibility:list=None, labels:list=[],
                timeout:int=0, flaky:bool|int=0, size:str=None):
    """Tests run by vitest.

    Vitest is vite: the same config file, the same plugin pipeline, the same
    transform. A component tested here is transformed exactly as it will be
    bundled, which is why this shares vite_bundle's config rather than having
    one of its own -- point it at a different config and the thing under test is
    not the thing that ships. That coupling is also why this rule lives here
    rather than beside the other test runners.

    Like vite, it comes from the consumer's tree. A repo's tests import describe
    and expect from the vitest it pinned, and its config imports plugins that
    have to match.

    Each test is reported to Please by name rather than the file being one
    result. vitest writes JUnit natively, so unlike node's own runner there is
    nothing to convert.

    Args:
        name: Target name.
        srcs: Test files, and anything they import that is not a dep.
        deps: js_library and ts_library targets the tests import by package
              name, and npm_repo targets.
        data: Targets the tests read rather than import.
        config: The vite config, relative to this package. Shared with
                vite_bundle on purpose.
        config_deps: Anything the config imports or extends.
        node_modules: The tree the tests resolve through, which holds vitest.
        env: Environment variables for the run.
        args: Further vitest flags.
        visibility: Visibility specification.
        labels: Additional labels.
        timeout: Test timeout in seconds.
        flaky: True to mark the test flaky, or an integer for reruns.
        size: Test size.
    """
    return js_test(
        name = name,
        srcs = [config] + srcs + config_deps,
        deps = deps,
        data = data,
        node_modules = node_modules,
        runner = "vitest",
        # CI mode: a missing snapshot fails the test rather than being written.
        # Without it vitest creates the file in the sandbox, the run passes,
        # and the snapshot is discarded with the tmp dir -- a test that asserts
        # nothing and never says so. Writing snapshots is vitest_update's job,
        # the only one allowed to touch the source tree.
        env = {"CI": "true"} | env,
        runner_args = [
            # `run`, not the default: vitest watches otherwise, and a test that
            # never exits is not a test.
            "run",
            "--config", config,
            "--reporter=junit",
            "--outputFile=$RESULTS_FILE",
        ] + args,
        visibility = visibility,
        labels = labels + ["vitest"],
        timeout = timeout,
        flaky = flaky,
        size = size,
    )


def vitest_update(name:str, srcs:list, deps:list=[], config:str="vite.config.ts",
                  config_deps:list=[], node_modules:str="", env:dict={},
                  args:list=[], visibility:list=None, labels:list=[]):
    """Rewrites committed snapshots. `plz run` only.

    A separate target rather than a flag on the test, because it writes to the
    source tree -- the same shape as npm_update, and for the same reason: a
    snapshot is a source, reviewed and committed, and a build action can touch
    neither the network nor the sources. vitest_test refuses to write one (its
    CI mode makes a missing snapshot a failure); this is the one sanctioned way
    they change.

    The test files are symlinked from the repository rather than copied, and a
    wrapper config resolves each snapshot beside the file's real path -- so a
    rewritten snapshot, and an inline snapshot vitest edits into the test file
    itself, lands in the developer's tree, while vitest and everything the
    tests import still resolve through the node_modules Please assembled.

    Args:
        name: Target name.
        srcs: The same test files the vitest_test names.
        deps: The same deps the vitest_test names.
        config: The vite config, shared with the test on purpose: a snapshot
                written under one pipeline and asserted under another would
                not survive the round trip.
        config_deps: Anything the config imports or extends.
        node_modules: The tree the tests resolve through, which holds vitest.
        env: Environment variables for the run.
        args: Further vitest flags -- a test name filter, most usefully.
        visibility: Visibility specification.
        labels: Additional labels.
    """
    wrapper = genrule(
        name = tag(name, "config"),
        srcs = [config],
        outs = ["_update.config.mjs"],
        cmd = " && ".join([
            'echo "import { mergeConfig } from \'vite\';" > "$OUT"',
            'echo "import { realpathSync } from \'node:fs\';" >> "$OUT"',
            'echo "import { dirname, join, basename } from \'node:path\';" >> "$OUT"',
            'echo "import user from \'./$(basename $SRCS)\';" >> "$OUT"',
            'echo "const base = typeof user === \'function\'" >> "$OUT"',
            'echo "  ? await user({ command: \'serve\', mode: \'test\' })" >> "$OUT"',
            'echo "  : user;" >> "$OUT"',
            'echo "export default mergeConfig(base, {" >> "$OUT"',
            # The tests are symlinks into the repository; resolving them away
            # would put them somewhere with no node_modules beside them.
            'echo "  resolve: { preserveSymlinks: true }," >> "$OUT"',
            # The snapshot goes beside the file the developer edits, not beside
            # the symlink: realpath of the linked test is the source file, so
            # __snapshots__ is created in the repository, which is the point.
            'echo "  test: { resolveSnapshotPath: (t, ext) =>" >> "$OUT"',
            'echo "    join(dirname(realpathSync(t)), \'__snapshots__\', basename(t) + ext) }," >> "$OUT"',
            'echo "});" >> "$OUT"',
        ]),
    )

    return js_binary(
        name = name,
        # Copied config, linked tests: node loads a config by real path, so a
        # linked one would resolve its plugins from the source tree. The tests
        # must be links -- their real path is where the snapshots belong.
        srcs = [config, wrapper] + config_deps + _generated(srcs),
        link_srcs = [s for s in srcs if s not in _generated(srcs)],
        deps = deps,
        node_modules = node_modules,
        runner = "vitest",
        runner_args = ["run", "--update", "--config", "_update.config.mjs"] + args,
        env = env,
        visibility = visibility,
        labels = labels + ["vitest_update"],
    )


def _generated(srcs:list):
    """The sources another rule produces, among a run target's sources.

    A development server links its sources from the repository, so an edit is
    served. A generated source has no file there to link: it is copied into
    the run directory as built, at its own path, and the links land beside it.
    A file of the same name in the source tree does not replace it.
    """
    return [s for s in srcs if s.startswith(":") or s.startswith("//")]


def _dev_config(name:str, config:str, deps:list, node_modules:str, out:str, merge_from:str, export:str,
                config_import:str=""):
    """The development server's config: the consumer's, loaded and wrapped.

    Shared by vite_dev, astro_dev and storybook_dev, which differ only in
    where the vite config sits -- the whole config, an Astro config's vite
    section, or what a Storybook main's viteFinal returns -- and so only in
    the export line that applies withPlzDev to it, and in where mergeConfig
    comes from: vite for vite_dev and storybook_dev; astro/config for
    astro_dev, since vite is Astro's own dependency rather than one the tree
    exposes. config_import is the path the generated module imports the
    consumer's config by, when that is not a sibling of it: a Storybook main
    sits in its config directory.
    """
    return genrule(
        name = tag(name, "config"),
        srcs = {"config": [config], "libs": deps, "tree": [node_modules or CONFIG.JS.NODE_MODULES]},
        outs = [out],
        cmd = " && ".join([
            # The first-party packages, by name, from the same lib.jsons the
            # overlay reads. Two things must be told about each: the optimizer,
            # or the served module is a cached prebundle rather than the
            # developer's source; and the watcher, whose default is to ignore
            # everything under node_modules.
            'NAMES=$("$TOOLS_PLEASE_JS" packages --dir .)',
            "EXCLUDE=$(for n in $NAMES; do printf \"'%s',\" \"$n\"; done)",
            # The watcher prunes traversal at every directory the ignore
            # matches, so negating the package's contents is not enough: each
            # ancestor -- the scope directory and the package directory itself
            # -- must be negated too, or the walk never reaches the files the
            # deeper negation names.
            # One negation per ancestor, including node_modules itself: the
            # watcher vite bundles (chokidar 3) tests each directory against
            # the ignore and prunes traversal there, and it matches the bare
            # node_modules directory against its own **/node_modules/** default
            # -- so without the first negation the walk never starts, and
            # without the others it stops one level short of the files the
            # last pattern names. Every one was found by watching it fail.
            'IGNORE=$([ -n "$NAMES" ] && printf "\'!**/node_modules\',"; ' +
            "for n in $NAMES; do " +
            'case "$n" in @*/*) printf "\'!**/node_modules/%s\'," "${n%%/*}";; esac; ' +
            'printf "\'!**/node_modules/%s\'," "$n"; ' +
            'printf "\'!**/node_modules/%s/**\'," "$n"; done)',
            # The output may sit in a directory of its own (storybook_dev's
            # config directory), which remote execution does not create.
            'mkdir -p "$(dirname "$OUT")"',
            f'echo "import {{ mergeConfig }} from \'{merge_from}\';" > "$OUT"',
            'echo "import path from \'node:path\';" >> "$OUT"',
            'echo "import fs from \'node:fs\';" >> "$OUT"',
            ('echo "import user from \'' + config_import + '\';" >> "$OUT"' if config_import else
             'echo "import user from \'./$(basename $SRCS_CONFIG)\';" >> "$OUT"'),
            'echo "const base = typeof user === \'function\'" >> "$OUT"',
            'echo "  ? await user({ command: \'serve\', mode: \'development\' })" >> "$OUT"',
            'echo "  : user;" >> "$OUT"',
            'echo "const EXCLUDE = [$EXCLUDE];" >> "$OUT"',
            'echo "const IGNORE = [$IGNORE];" >> "$OUT"',
            # The application's own third-party dependencies: the top of the
            # tree, scoped packages one level down. A bare import in the
            # application's source can only name one of these.
            "DIRECT=$(cd $SRCS_TREE && for d in *; do case \"$d\" in @*) for p in \"$d\"/*; do printf \"'%s',\" \"$p\"; done;; *) printf \"'%s',\" \"$d\";; esac; done)",
            'echo "const DIRECT = [$DIRECT];" >> "$OUT"',
        ]) + " && cat >> \"$OUT\" <<'PLZ_DEV_CONFIG'\n" + _VITE_DEV_CONFIG + "\n" + export + "\nPLZ_DEV_CONFIG",
        tools = {"please_js": ["///js//tools/please_js"]},
    )


_VITE_DEV_CONFIG = """
const runDir = process.cwd();
const marker = path.sep + "plz-out" + path.sep;
if (!runDir.includes(marker)) {
  throw new Error("vite_dev: expected to run under plz-out, ran in " + runDir);
}
const repoRoot = runDir.slice(0, runDir.indexOf(marker));

// The sources were linked into this run directory when it started (js-rules'
// link-sources, from links.json), and that is all a link made at start can
// know. A file created since -- reached by URL, through a config-relative
// alias such as "@/" (resolved against this directory, since the config is a
// copy here), from public/, or by a tool that globs this directory, like
// Tailwind -- needs its link to exist here too. So the source directories the
// spec marks live are watched, and each file added or removed under one is
// linked or unlinked, by the same skip rules link-sources applied.
//
// On vite's own watcher, not a second one: events arrive in the order they
// happened, so a new file's link exists before the edit that imports it is
// handled. A separate process would race that.
const links = JSON.parse(fs.readFileSync(path.join(runDir, "links.json"), "utf8"));
const skipped = (rel) => rel.split(path.sep).some((seg) =>
  links.skip.dirs.includes(seg) ||
  links.skip.prefixes.some((p) => seg.startsWith(p)) ||
  links.skip.suffixes.some((x) => seg.endsWith(x)));
// Sources are symlinked into this run directory from the repository, and vite
// resolves a symlink to its real path -- in the repository, where no plz tree
// sits beside it and a stray npm install might. Everything that then looks up
// from a module's path went wrong there: a bare import, a stylesheet's
// @import, the nearest tsconfig and what it extends (astro/tsconfigs/strict),
// whether a server-rendered import stays a node import. So a module from the
// repository keeps the path of its link here as its id: every lookup happens
// beside the tree, exactly as in a build, where the sources are staged next
// to node_modules. Third-party packages keep their real paths, which the
// store layout needs to find each package's dependencies as siblings.
const linkSets = links.sets
  .map((set) => ({ real: path.join(repoRoot, set.from) + path.sep, link: path.join(runDir, set.into) + path.sep }))
  .sort((a, b) => b.real.length - a.real.length);
const linkIds = {
  name: "plz-link-ids",
  enforce: "pre",
  async resolveId(source, importer, options) {
    const resolved = await this.resolve(source, importer, { ...options, skipSelf: true });
    if (!resolved || resolved.external) return resolved;
    const set = linkSets.find((s) => resolved.id.startsWith(s.real));
    return set ? { ...resolved, id: set.link + resolved.id.slice(set.real.length) } : resolved;
  },
};
const live = links.sets.flatMap((set) => (set.live ?? []).map((dir) => ({
  real: path.join(repoRoot, set.from, dir),
  from: path.join(repoRoot, set.from),
  into: path.join(runDir, set.into),
})));
// The link a source file has, or would have, in this run; null if it is in no
// live directory or is skipped.
const linkFor = (file) => {
  const l = live.find((d) => file.startsWith(d.real + path.sep));
  if (!l) return null;
  const rel = path.relative(l.from, file);
  return skipped(rel) ? null : path.join(l.into, rel);
};
const liveLinks = {
  name: "plz-live-links",
  configureServer(server) {
    server.watcher.add(live.map((d) => d.real));
    server.watcher.on("add", (file) => {
      const at = linkFor(file);
      if (!at) return;
      // A real file in the way is the build's -- the copied config, a
      // generated manifest -- and is left alone, as link-sources does.
      if (fs.lstatSync(at, { throwIfNoEntry: false })?.isSymbolicLink() === false) return;
      fs.mkdirSync(path.dirname(at), { recursive: true });
      fs.rmSync(at, { force: true });
      fs.symlinkSync(file, at);
    });
    server.watcher.on("unlink", (file) => {
      const at = linkFor(file);
      if (at && fs.lstatSync(at, { throwIfNoEntry: false })?.isSymbolicLink()) fs.rmSync(at);
    });
  },
};

// What the first-party libraries import from third-party packages, for the
// optimizer. They are excluded from it (EXCLUDE), so its scan never reads
// them, and a bare import found only there -- @mui/material/CssBaseline in a
// design system, say, when the application never names it -- is served raw.
// Raw is fine for ES modules and fatal for CommonJS (react-is behind
// @mui/utils): the browser finds no named export to link, and the page dies
// on a SyntaxError. The library's own files are read here instead, and each
// specifier is included as "<library> > <specifier>", vite's form for a
// dependency resolved from the library rather than the application -- which
// is where the tree places it.
const LIBRARY_IMPORTS = (() => {
  const specifiers = /(?:^|[\\s;])(?:import|export)(?!\\s+type\\b)[^'"`;]*?\\bfrom\\s*['"]([^'"./][^'"]*)['"]|\\bimport\\s*\\(\\s*['"]([^'"./][^'"]*)['"]\\s*\\)|^\\s*import\\s*['"]([^'"./][^'"]*)['"]/gm;
  const found = new Set();
  const read = (lib, dir) => {
    for (const entry of fs.readdirSync(dir, { withFileTypes: true })) {
      const file = path.join(dir, entry.name);
      if (entry.isDirectory()) {
        if (entry.name !== "node_modules") read(lib, file);
        continue;
      }
      if (!/\\.[cm]?[jt]sx?$/.test(entry.name) || entry.name.endsWith(".d.ts")) continue;
      for (const m of fs.readFileSync(file, "utf8").matchAll(specifiers)) {
        const spec = m[1] ?? m[2] ?? m[3];
        // Node's own modules, and the first-party libraries, which are served
        // from source rather than prebundled.
        if (spec.startsWith("node:") || EXCLUDE.some((n) => spec === n || spec.startsWith(n + "/"))) continue;
        found.add(lib + " > " + spec);
      }
    }
  };
  for (const lib of EXCLUDE) read(lib, fs.realpathSync(path.join(runDir, "node_modules", lib)));
  return [...found].sort();
})();

// What the development server adds to a vite config: vite_dev applies it to
// the application's config, astro_dev to the vite section of an Astro one.
const withPlzDev = (viteConfig) => {
const merged = mergeConfig(viteConfig, {
  plugins: [linkIds, liveLinks],
  // The tree is a build output: vite's cache goes beside the run, never into it.
  cacheDir: path.join(runDir, ".vite"),
  optimizeDeps: { exclude: EXCLUDE, include: LIBRARY_IMPORTS },
  server: {
    // Real paths are in the repository, so that is what vite may serve.
    fs: { allow: [runDir, repoRoot] },
    watch: { ignored: IGNORE },
  },
  // One resolver ignores plugins, linkIds included: the one vite uses for a
  // stylesheet's @import. It resolves a nested @import from the real path of
  // the stylesheet holding it, in the repository, where no tree sits. A
  // deduped package resolves from the root -- this run directory -- instead,
  // so every package a bare import in the application's own files can name
  // is deduped: its third-party dependencies and the first-party libraries.
  resolve: { dedupe: [...DIRECT, ...EXCLUDE] },
});
return merged;
};
"""


def vite_dev(name:str, srcs:list, deps:list=[], config:str="vite.config.ts",
             config_deps:list=[], node_modules:str="", env:dict={},
             args:list=[], visibility:list=None, labels:list=[]):
    """A vite development server, for `plz run`.

    Deliberately not hermetic, and it cannot be: the whole job is reacting to
    files that change after the build. It is a run target and never a build
    action.

    Everything Please generates still lives in plz-out. The server runs there,
    and the sources are symlinked into it rather than node_modules being
    symlinked next to them -- which would write into the source tree, and would
    create exactly the stray node_modules js-rules warns about.

    A module from the repository keeps its link's path here as its id, rather
    than the real path vite would resolve it to, so everything that looks up
    from a module's path -- a bare import, a stylesheet's @import, the
    nearest tsconfig and what it extends, whether a server-rendered import
    stays a node import -- happens beside the tree, exactly as in a build,
    where sources are staged next to node_modules. Third-party packages keep
    their real paths, which the store layout needs. The watcher follows each
    link (chokidar's followSymlinks), so an edit to the real file hot-swaps
    the module, while nothing outside plz-out is touched.

    Files created after the server started are served too, with no restart:
    by URL, through a config-relative alias such as "@/", from public/, and
    to tools that glob the run directory, like Tailwind. Every top-level
    directory of the package holding a declared source (src/, public/) is
    live: a plugin on vite's own watcher links each file added under one and
    unlinks each file removed, in event order, so a new file's link exists
    before the edit importing it is handled. The same holds for a
    first-party library's source directories. Files at the package's top
    level are linked as declared, since that is where BUILD, package.json
    and node_modules live. test/ts/vite/app/verify_hmr.sh proves each case.

    What this gives that running vite by hand does not: Please assembles
    node_modules first, with first-party libraries overlaid. In a monorepo those
    packages exist in no hand-made tree.

    For a headless rebuild loop, `plz watch -r //app:bundle` is the right tool
    and this is not -- it restarts the process, which is exactly what this
    exists to avoid.

    Args:
        name: Target name.
        srcs: Everything the server reads: index.html, sources, styles, assets,
              and any .env file, which vite loads from its root. A source
              another rule generates is served as built, at its own path; it
              changes when the target is rebuilt, not on save.
        deps: js_library and ts_library targets the sources import by package
              name, and npm_repo targets.
        config: The vite config, relative to this package. The same one
                vite_bundle uses, so what runs in development is what ships.
        config_deps: Anything the config imports or extends.
        node_modules: The tree the server resolves through, holding vite.
        env: Environment variables for the server.
        args: Further vite flags.
        visibility: Visibility specification.
        labels: Additional labels.

    Port, proxy, host, allowedHosts and server.fs.allow are deliberately absent:
    they live in vite.config.ts, where a vite user already knows to put them.
    """
    # The server runs on the same store-layout tree builds and tests use, so
    # nothing is copied for it. The rule supplies what that needs -- resolving
    # the repository's sources through the tree -- rather than leaving it in the
    # consumer's config where it would look like their choice. Wrapping rather
    # than rewriting: the config stays theirs.
    wrapper = _dev_config(name, config, deps, node_modules, "_dev.config.mjs", "vite",
                          "export default withPlzDev(base);")

    return js_binary(
        name = name,
        # The config is copied, the sources are linked, and the difference is
        # not arbitrary: node loads a config by its real path, so a symlinked
        # one would resolve its own plugin imports from the source tree, where
        # there is no node_modules. It is read once at startup anyway. The
        # sources are read continuously and must be the developer's own files.
        srcs = [config, wrapper] + config_deps + _generated(srcs),
        link_srcs = [s for s in srcs if s not in _generated(srcs)],
        deps = deps,
        node_modules = node_modules,
        link_deps = True,
        # Source directories linked whole and kept in step by liveLinks, so a
        # file created mid-session is served. vitest_update leaves this off:
        # vitest globs its run directory for tests, and must find only its own.
        link_live = True,
        runner = "vite",
        # No subcommand: `vite` with no arguments is the dev server, and naming
        # it `dev` would be an alias for the same thing.
        runner_args = ["--config", "_dev.config.mjs"] + args,
        env = env,
        visibility = visibility,
        labels = labels + ["vite_dev"],
    )


def astro_build(name:str, srcs:list, deps:list=[], config:str="astro.config.mjs",
                config_deps:list=[], out_dir:str="dist", node_modules:str="",
                env:dict={}, check=None, args:list=[], visibility:list=None,
                test_only:bool&testonly=False, labels:list=[]):
    """A static site produced by Astro's own build.

    The vite_bundle of an Astro project. Astro drives vite internally and has
    a config of its own, so it is run through its own CLI rather than through
    vite's -- and, like vite, from the consumer's tree, because an Astro
    config imports integrations that must match the Astro they are loaded
    into.

    Like vite_bundle, the output is the out_dir itself: Astro writes it under
    a directory of this target's own, and that one is hoisted, so the target's
    output is <out_dir>/ and two builds in one package cannot collide.

    Args:
        name: Target name.
        srcs: Everything the build reads: src/ (pages, content collections,
              components, styles), public/, and any .env file.
        deps: js_library and ts_library targets the sources import by package
              name, and npm_repo targets.
        config: The Astro config, relative to this package.
        config_deps: Anything the config imports or extends.
        out_dir: The directory the site is, and the target's output.
                 Overrides outDir in the config.
        node_modules: The tree the build resolves through, holding astro.
        env: Environment variables for the action. Anything the config or the
             pages read from process.env has to come through here.
        check: An astro_check (or ts_check) over these sources, made a
               dependency so the site cannot be produced while it fails.
               Required when any source is TypeScript, as for vite_bundle;
               False to build unchecked TypeScript deliberately.
        args: Further astro build flags.
        visibility: Visibility specification.
        test_only: If True, only visible to test rules.
        labels: Additional labels.
    """
    wrapper = f"_{name}"
    return js_run_binary(
        name = name,
        package = "astro",
        bin = "astro",
        deps = deps + _checked("astro_build", name, srcs, check),
        node_modules = node_modules,
        srcs = [config] + srcs + config_deps,
        # Astro names its output files by content, so nothing can be declared.
        out_dirs = [wrapper],
        args = ["build", "--config", config, "--outDir", f"{wrapper}/{out_dir}"] + args,
        env = env,
        visibility = visibility,
        test_only = test_only,
        labels = labels + ["astro_build"],
    )


def astro_check(name:str, srcs:list, deps:list=[], config:str="astro.config.mjs",
                config_deps:list=[], tsconfig:str="tsconfig.json", node_modules:str="",
                args:list=[], visibility:list=None, test_only:bool&testonly=False,
                labels:list=[]):
    """Type-checks an Astro project: its .astro components as well as its
    TypeScript, which ts_check cannot read.

    `astro check` (from @astrojs/check, which the consumer's tree must hold)
    runs Astro's language server over the project and fails on any error.
    It writes nothing but its report, which this captures as the target's
    output, so a passing check is a cached file and a failing one a build
    failure.

    Args:
        name: Target name.
        srcs: The sources to check: .astro, .ts, content collections.
        deps: js_library and ts_library targets the sources import by name.
        config: The Astro config, relative to this package.
        config_deps: Anything the config imports or extends.
        tsconfig: The project's tsconfig.
        node_modules: The tree holding astro, @astrojs/check and typescript.
        args: Further astro check flags.
        visibility: Visibility specification.
        test_only: If True, only visible to test rules.
        labels: Additional labels.
    """
    return js_run_binary(
        name = name,
        package = "astro",
        bin = "astro",
        deps = deps,
        node_modules = node_modules,
        srcs = [config, tsconfig] + srcs + config_deps,
        args = ["check", "--config", config] + args,
        stdout = f"{name}.checked",
        visibility = visibility,
        test_only = test_only,
        labels = labels + ["astro_check"],
    )


def astro_dev(name:str, srcs:list, deps:list=[], config:str="astro.config.mjs",
              config_deps:list=[], tsconfig:str="tsconfig.json", node_modules:str="", env:dict={},
              args:list=[], visibility:list=None, labels:list=[]):
    """An Astro development server, for `plz run`.

    vite_dev for an Astro project, and the same machinery: the server runs in
    plz-out, the sources are linked in from the repository and kept in step
    as files come and go, first-party libraries are served from their
    sources, and a bare import from a repository file -- a module's or a
    stylesheet's -- resolves through the tree Please built. Astro runs vite
    itself, so that machinery goes into the vite section of the Astro config
    rather than into a vite config.

    Args:
        name: Target name.
        srcs: Everything the server reads: src/, public/, any .env file.
        deps: js_library and ts_library targets the sources import by name.
        config: The Astro config, relative to this package. The same one
                astro_build uses.
        config_deps: Anything the config imports or extends.
        tsconfig: The project's tsconfig. Copied rather than linked, like the
                  config: Astro reads it once, and its extends (typically
                  astro/tsconfigs/strict) must resolve through the tree here,
                  not from its real path in the repository.
        node_modules: The tree the server resolves through, holding astro.
        env: Environment variables for the server.
        args: Further astro dev flags.
        visibility: Visibility specification.
        labels: Additional labels.
    """
    wrapper = _dev_config(name, config, deps, node_modules, "_dev.astro.config.mjs", "astro/config",
                          "export default { ...base, vite: withPlzDev(base.vite ?? {}) };")
    return js_binary(
        name = name,
        # Copied and linked as vite_dev does, for the same reasons.
        srcs = [config, wrapper, tsconfig] + config_deps + _generated(srcs),
        link_srcs = [s for s in srcs if s not in _generated(srcs)],
        deps = deps,
        node_modules = node_modules,
        link_deps = True,
        link_live = True,
        runner = "astro",
        runner_args = ["dev", "--config", "_dev.astro.config.mjs"] + args,
        env = env,
        visibility = visibility,
        labels = labels + ["astro_dev"],
    )


def _storybook_main(config_dir:str, extra:str, vite_final:str):
    """The body of the main Storybook reads from the rule's config directory:
    the consumer's main, `base`, extended. The consumer's preview, manager and
    head files are passed through from their own directory, which Storybook no
    longer reads itself. Expects `base`, `runDir`, `fs` and `path` in scope;
    `extra` adds fields, and `vite_final` is the expression viteFinal returns,
    with `config` and `options` in scope."""
    return "\n".join([
        f'const userDir = path.join(runDir, "{config_dir}");',
        # The consumer's own files, by the names Storybook looks for in a config
        # directory: the preview and manager modules, and the head and body
        # fragments.
        'const userModule = (base) => ["tsx", "ts", "jsx", "js", "mjs", "cjs"]',
        '  .map((ext) => path.join(userDir, base + "." + ext)).find((f) => fs.existsSync(f));',
        'const userText = (file) => fs.existsSync(path.join(userDir, file))',
        '  ? fs.readFileSync(path.join(userDir, file), "utf8") : "";',
        'const userPreview = userModule("preview");',
        'const userManager = userModule("manager");',
        # A main's preset properties are values or functions of what came before;
        # both are honoured, and the consumer's own value applied first.
        'const chained = async (key, value, options, extra) => {',
        '  const own = base[key];',
        '  const v = typeof own === "function" ? await own(value, options) : own === undefined ? value : own;',
        '  return extra(v);',
        '};',
        'export default {',
        '  ...base,',
        extra,
        '  previewAnnotations: (entries = [], options) => chained("previewAnnotations", entries, options,',
        '    (v) => (userPreview ? [...v, userPreview] : v)),',
        '  managerEntries: (entries = [], options) => chained("managerEntries", entries, options,',
        '    (v) => (userManager ? [...v, userManager] : v)),',
        '  previewHead: (head = "", options) => chained("previewHead", head, options, (v) => v + userText("preview-head.html")),',
        '  previewBody: (body = "", options) => chained("previewBody", body, options, (v) => v + userText("preview-body.html")),',
        '  managerHead: (head = "", options) => chained("managerHead", head, options, (v) => v + userText("manager-head.html")),',
        f'  viteFinal: async (config, options) => {vite_final},',
        '};',
    ])


def storybook_build(name:str, srcs:list, deps:list=[], config_dir:str=".storybook",
                    config_deps:list=[], out_dir:str="storybook-static", node_modules:str="",
                    env:dict={}, check=None, args:list=[], visibility:list=None,
                    test_only:bool&testonly=False, labels:list=[]):
    """A static Storybook, produced by `storybook build`.

    Storybook is a vite application with a config directory of its own, so
    this is vite_bundle's shape run through Storybook's CLI: from the
    consumer's tree, because a Storybook main names a framework and addons
    that must match the Storybook they are loaded into; and with nothing
    passed that the main could also set. The framework's vite builder merges
    the project's vite config itself, so an alias the application relies on
    reaches its stories too.

    The output is the out_dir itself, as for vite_bundle: one directory, the
    shape vercel_site deploys and playwright_test serves.

    Args:
        name: Target name.
        srcs: Everything the build reads: the config directory's files, the
              stories and what they import, styles, assets, any vite config
              and tsconfig it reads.
        deps: js_library and ts_library targets the stories import by package
              name, and npm_repo targets.
        config_dir: Storybook's config directory, relative to this package.
        config_deps: Anything the config imports or extends that is not in
                     srcs, such as a tsconfig the project's extends.
        out_dir: The directory the site is, and the target's output.
        node_modules: The tree the build resolves through, holding storybook,
                      its framework and addons.
        env: Environment variables for the action.
        check: A ts_check over these sources, made a dependency so the site
               cannot be produced while it fails. Required when any source is
               TypeScript, as for vite_bundle; False to build unchecked
               TypeScript deliberately.
        args: Further storybook build flags.
        visibility: Visibility specification.
        test_only: If True, only visible to test rules.
        labels: Additional labels.
    """
    mains = [s for s in srcs if s.startswith(config_dir + "/main.")]
    if len(mains) != 1:
        fail(f"storybook_build {name}: srcs must hold exactly one {config_dir}/main.*, found {mains}")
    main = mains[0]
    wrap_dir = f"_{name}.storybook"
    body = _storybook_main(config_dir,
        # The application's public/ goes to Storybook as a static directory
        # rather than being copied by vite as well: both copied a favicon.svg,
        # and where inputs are read-only -- remote execution -- the second copy
        # failed on the first. Storybook prefers the application's favicon.
        extra = "\n".join([
            '  staticDirs: base.staticDirs ?? (fs.existsSync(path.join(runDir, "public")) ? [path.join(runDir, "public")] : []),',
        ]),
        vite_final = "((c) => ({ ...c, build: { ...c.build, copyPublicDir: false } }))(" +
                     "typeof base.viteFinal === \"function\" ? await base.viteFinal(config, options) : config)")
    generated = genrule(
        name = tag(name, "config"),
        outs = [f"{wrap_dir}/main.mjs"],
        cmd = "\n".join([
            'mkdir -p "$(dirname "$OUT")"',
            "cat > $OUT <<'PLZ_SB'",
            'import fs from "node:fs";',
            'import path from "node:path";',
            f'import user from "../{main}";',
            "const base = user;",
            # The build runs in this package's directory, where the consumer's
            # config directory sits beside this one.
            "const runDir = process.cwd();",
            body,
            "PLZ_SB",
        ]),
    )
    wrapper = f"_{name}"
    return js_run_binary(
        name = name,
        package = "storybook",
        bin = "storybook",
        deps = deps + _checked("storybook_build", name, srcs, check),
        node_modules = node_modules,
        srcs = srcs + config_deps + [generated],
        # vite content-hashes filenames, so nothing here can be declared.
        out_dirs = [wrapper],
        # A build action has no network to report to.
        args = ["build", "--config-dir", wrap_dir, "--output-dir", f"{wrapper}/{out_dir}",
                "--disable-telemetry"] + args,
        env = env,
        visibility = visibility,
        test_only = test_only,
        labels = labels + ["storybook_build"],
    )


def storybook_dev(name:str, srcs:list, deps:list=[], config_dir:str=".storybook",
                  vite_config:str="vite.config.ts", tsconfig:str="tsconfig.json",
                  config_deps:list=[], node_modules:str="", env:dict={}, args:list=[],
                  visibility:list=None, labels:list=[]):
    """A Storybook development server, for `plz run`.

    vite_dev for a Storybook, and the same machinery: the server runs in
    plz-out, the sources are linked in from the repository and kept in step
    as files come and go, first-party libraries are served from their sources
    with what they import prebundled, and a bare import from a repository
    file resolves through the tree Please built. Storybook runs vite itself,
    so that machinery goes in through the main's viteFinal.

    Storybook reads its config from a directory rather than a file, so the
    rule gives it one: _<name>.storybook beside the consumer's, at the same
    depth so the main's relative story globs mean what they say. Its main is
    the consumer's, imported and extended; the preview, manager and head
    files are the consumer's own, linked and passed through, so editing the
    preview reloads like editing a story.

    Args:
        name: Target name.
        srcs: Everything the server reads: the config directory's files, the
              stories and what they import, styles, assets, any vite config
              and tsconfig it reads.
        deps: js_library and ts_library targets the stories import by name.
        config_dir: Storybook's config directory, relative to this package.
                    Its main is copied rather than linked, like a vite config:
                    node loads it by its real path, and its framework and
                    addons must resolve through the tree here.
        vite_config: The project's vite config, which Storybook's vite builder
                     merges. Copied rather than linked when srcs hold it, for
                     the reason the main is: it imports plugins by name.
        tsconfig: The project's tsconfig. Copied rather than linked when srcs
                  hold it, as astro_dev does, so what it extends resolves
                  through the tree here.
        config_deps: Anything the config imports or extends that is not in
                     srcs.
        node_modules: The tree the server resolves through, holding storybook.
        env: Environment variables for the server.
        args: Further storybook dev flags: the port (-p) most usefully.
        visibility: Visibility specification.
        labels: Additional labels.
    """
    mains = [s for s in srcs if s.startswith(config_dir + "/main.")]
    if len(mains) != 1:
        fail(f"storybook_dev {name}: srcs must hold exactly one {config_dir}/main.*, found {mains}")
    main = mains[0]
    wrap_dir = f"_{name}.storybook"
    found = _storybook_main(config_dir,
        extra = "",
        vite_final = "withPlzDev(typeof base.viteFinal === \"function\" ? await base.viteFinal(config, options) : config)")
    wrapper = _dev_config(name, main, deps, node_modules, f"{wrap_dir}/main.mjs", "vite", found,
                          config_import = "../" + main)
    copied = [main] + [s for s in srcs if s in [vite_config, tsconfig]] + _generated(srcs)
    return js_binary(
        name = name,
        srcs = copied + [wrapper] + config_deps,
        link_srcs = [s for s in srcs if s not in copied],
        deps = deps,
        node_modules = node_modules,
        link_deps = True,
        link_live = True,
        runner = "storybook",
        # --ci: no prompts and no browser opened; the version check and
        # telemetry reach the network, which a development server for one
        # repository has no reason to.
        runner_args = ["dev", "--config-dir", wrap_dir, "--ci", "--no-open",
                       "--disable-telemetry", "--no-version-updates"] + args,
        env = env,
        visibility = visibility,
        labels = labels + ["storybook_dev"],
    )


# Where Chrome for Testing publishes each platform's headless shell, keyed by
# Please's OS and architecture. The same CDN and names playwright-core's own
# installer uses (lib/server/registry: cftUrl), so what this downloads is
# byte-for-byte what `playwright install` would have.
_PLAYWRIGHT_PLATFORMS = {
    "darwin_amd64": "mac-x64",
    "darwin_arm64": "mac-arm64",
    "linux_amd64": "linux64",
    "linux_arm64": "linux-arm64",
}


def playwright_browser(name:str, browser_version:str, revision:str, hashes:dict,
                       visibility:list=None):
    """The Chromium playwright_test runs in, as a hash-pinned download.

    `playwright install` fetches whatever its CDN serves when it runs, into a
    cache outside the build. That is the one place a Playwright suite would
    otherwise reach the network, so the browser is a build input here like
    any other: a remote_file per platform, checked against its hash.

    Laid out the way Playwright's own registry lays it out
    (<name>/chromium_headless_shell-<revision>/chrome-headless-shell-<platform>/),
    so playwright_test hands Playwright the binary inside it and Playwright is
    used unmodified.

    Args:
        name: Target name.
        browser_version: Chrome for Testing version, as playwright-core's
                         browsers.json gives it for chromium-headless-shell.
        revision: That entry's revision. playwright_test checks it against the
                  revision the consumer's Playwright expects.
        hashes: sha256 of each platform's zip, keyed "<os>_<arch>" as Please
                names them (linux_amd64, darwin_arm64, ...). A platform with no
                hash fails at parse time rather than downloading unchecked.
        visibility: Visibility specification.
    """
    key = CONFIG.OS + "_" + CONFIG.ARCH
    platform = _PLAYWRIGHT_PLATFORMS.get(key)
    if not platform:
        fail("playwright_browser " + name + ": Chrome for Testing has no headless shell for " + key)
    if key not in hashes:
        fail("playwright_browser " + name + ": no hash for " + key + "; add it to hashes")
    zip = remote_file(
        name = tag(name, "zip"),
        url = "https://cdn.playwright.dev/builds/cft/" + browser_version + "/" + platform +
              "/chrome-headless-shell-" + platform + ".zip",
        hashes = [hashes[key]],
        extract = True,
        # Named apart from the platform directory below: an output here called
        # chrome-headless-shell-<platform> collides with the one the genrule
        # writes, and Please merges the two -- the binary lands a level up.
        out = name + "_download",
    )
    return genrule(
        name = name,
        srcs = [zip],
        outs = [name],
        # Into the layout Playwright's registry uses. Whether extract kept the
        # zip's one top-level directory or stripped it, the files end up in
        # chrome-headless-shell-<platform>.
        cmd = " && ".join([
            'DEST="$OUT/chromium_headless_shell-' + revision + '/chrome-headless-shell-' + platform + '"',
            'SRC="$(location ' + zip + ')"',
            '[ -d "$SRC/chrome-headless-shell-' + platform + '" ] && SRC="$SRC/chrome-headless-shell-' + platform + '"',
            'mkdir -p "$DEST"',
            'cp -R "$SRC"/. "$DEST/"',
            # Playwright's own installer writes this marker beside the browser.
            'touch "$OUT/chromium_headless_shell-' + revision + '/INSTALLATION_COMPLETE"',
            # Remote execution stages inputs read-only, and a copy keeps the mode.
            'chmod -R u+w "$OUT"',
        ]),
        visibility = visibility,
        labels = ["playwright_browser:" + revision],
    )


# Serves a built site for playwright_test, from loopback, on a port the OS
# picks. A file that exists is served; a path without an extension that does
# not is an app route and gets index.html, the same fallback vercel_site's
# config gives the deployed site; anything else is a 404, so a missing asset
# fails the test instead of passing as HTML.
_PLAYWRIGHT_SERVER = """
import { createServer } from "node:http";
import { readFile, stat } from "node:fs/promises";
import path from "node:path";

const TYPES = {
  ".html": "text/html; charset=utf-8", ".js": "text/javascript; charset=utf-8",
  ".mjs": "text/javascript; charset=utf-8", ".css": "text/css; charset=utf-8",
  ".json": "application/json", ".svg": "image/svg+xml", ".png": "image/png",
  ".jpg": "image/jpeg", ".jpeg": "image/jpeg", ".gif": "image/gif", ".webp": "image/webp",
  ".ico": "image/x-icon", ".woff": "font/woff", ".woff2": "font/woff2", ".txt": "text/plain; charset=utf-8",
  ".map": "application/json", ".webmanifest": "application/manifest+json",
};

async function isFile(p) {
  try { return (await stat(p)).isFile(); } catch { return false; }
}

function serve(root, host, port) {
  const server = createServer(async (req, res) => {
    const url = new URL(req.url ?? "/", "http://localhost");
    const rel = decodeURIComponent(url.pathname);
    let file = path.join(root, rel);
    if (!file.startsWith(root)) { res.writeHead(403).end(); return; }
    if (rel.endsWith("/")) file = path.join(file, "index.html");
    if (!(await isFile(file))) {
      if (path.extname(rel) !== "") { res.writeHead(404).end(); return; }
      file = path.join(root, "index.html");
    }
    const body = await readFile(file);
    res.writeHead(200, { "content-type": TYPES[path.extname(file)] ?? "application/octet-stream" }).end(body);
  });
  return new Promise((resolve, reject) => {
    server.once("error", reject);
    server.listen(port, host, () => resolve(server));
  });
}
"""

# Playwright's globalSetup, after the server in one module: starts it before
# any worker exists and publishes its address in the environment. Workers
# re-read the config, so the baseURL they see is this one. One file with no
# local imports, because Playwright's TypeScript loader does not carry named
# exports between generated modules.
_PLAYWRIGHT_SETUP = """
export default async function globalSetup() {
  // A fixed origin when the suite asked for one, else any free port.
  const origin = process.env.PLZ_PLAYWRIGHT_ORIGIN;
  const fixed = origin ? new URL(origin) : null;
  const server = await serve(process.env.PLZ_PLAYWRIGHT_SITE,
    fixed ? fixed.hostname : "127.0.0.1", fixed ? Number(fixed.port) : 0);
  process.env.PLZ_PLAYWRIGHT_BASE_URL = origin || `http://127.0.0.1:${server.address().port}`;
  return () => new Promise((resolve) => server.close(() => resolve()));
}
"""

# Finds the site and the browser where Please staged them, checks the browser
# is the revision this Playwright expects, and names its binary. Data is staged
# under the test's root while the runner starts in its run directory, so the
# paths are found by walking up rather than assumed.
_PLAYWRIGHT_PATHS = """
import { existsSync, readdirSync, readFileSync } from "node:fs";
import { createRequire } from "node:module";
import path from "node:path";

function staged(rel) {
  for (let dir = process.cwd(); ; dir = path.dirname(dir)) {
    const candidate = path.join(dir, rel);
    if (existsSync(candidate)) return candidate;
    if (path.dirname(dir) === dir) throw new Error(`playwright_test: ${rel} is not staged for this test`);
  }
}

// playwright_update runs from `plz run`, where nothing is staged: the site and
// the browser are read where Please built them, from the repository root.
function built(out) {
  const marker = path.sep + "plz-out" + path.sep;
  const cwd = process.cwd();
  if (!cwd.includes(marker)) throw new Error(`playwright_update: expected to run under plz-out, ran in ${cwd}`);
  return path.join(cwd.slice(0, cwd.indexOf(marker)), out);
}

const browserRoot = PLZ_UPDATE ? built(PLZ_UPDATE.browser) : staged(PLZ_BROWSER);
const [shell] = readdirSync(browserRoot).filter((d) => d.startsWith("chromium_headless_shell-"));
if (!shell) throw new Error(`playwright_test: ${browserRoot} holds no chromium_headless_shell-<revision>`);
const revision = shell.slice("chromium_headless_shell-".length);

// The revision the consumer's Playwright was built against. A browser from
// another revision may launch and then misbehave in ways no error names, so a
// mismatch stops here, saying which side to move.
// Followed through the packages, not resolved from the root: in the store
// layout only @playwright/test is a top-level name, and playwright-core is its
// dependency's dependency.
const fromRun = createRequire(path.join(process.cwd(), "noop.js"));
const fromTest = createRequire(fromRun.resolve("@playwright/test/package.json"));
const fromPlaywright = createRequire(fromTest.resolve("playwright/package.json"));
// browsers.json is not in playwright-core's exports; package.json is, and the
// registry sits beside it.
const corePackage = fromPlaywright.resolve("playwright-core/package.json");
const registry = JSON.parse(readFileSync(path.join(path.dirname(corePackage), "browsers.json"), "utf8"));
const expected = registry.browsers.find((b) => b.name === "chromium-headless-shell");
if (!expected || expected.revision !== revision) {
  throw new Error(
    `playwright_test: the browser is chromium-headless-shell ${revision}, but this Playwright expects ` +
    `${expected ? expected.revision + " (Chrome " + expected.browserVersion + ")" : "none"}. ` +
    "Point PlaywrightBrowser (or the rule's browser) at a playwright_browser for that revision.");
}

const [platformDir] = readdirSync(path.join(browserRoot, shell)).filter((d) => d.startsWith("chrome-headless-shell-"));
const executable = path.join(browserRoot, shell, platformDir, process.platform === "win32" ? "chrome-headless-shell.exe" : "chrome-headless-shell");

const PLZ = { site: PLZ_UPDATE ? built(PLZ_UPDATE.site) : staged(PLZ_SITE), executable };
"""

# The config Playwright runs with: the app's own, with its webServer replaced
# by the staged site, its baseURL by the server's, and every project launched
# in the pinned browser.
_PLAYWRIGHT_CONFIG = """
import { defineConfig } from "@playwright/test";

const base = user;
// globalSetup runs in this process after the config loads, and reads the site
// from here.
process.env.PLZ_PLAYWRIGHT_SITE = PLZ.site;
process.env.PLZ_PLAYWRIGHT_ORIGIN = PLZ_ORIGIN;
if (base.globalSetup) {
  throw new Error("playwright_test: the config sets globalSetup; this rule needs it to serve the site");
}
const launch = (use) => ({
  ...use,
  baseURL: process.env.PLZ_PLAYWRIGHT_BASE_URL,
  launchOptions: {
    ...(use?.launchOptions ?? {}),
    executablePath: PLZ.executable,
    // A container's /dev/shm is 64MB, which Chrome outgrows and then crashes in.
    args: [...(use?.launchOptions?.args ?? []), "--disable-dev-shm-usage"],
  },
});

// Snapshots, when updating, are written where the suite reads them from: the
// package in the repository, not this run. Every directory a snapshot path is
// built from is made absolute there; a test leaves them alone, and reads the
// copies staged beside its specs.
const repoPackage = PLZ_UPDATE ? built(PLZ_UPDATE.pkg) : null;
const snapshots = (c) => {
  if (!repoPackage) return {};
  const testDir = path.resolve(repoPackage, c.testDir ?? base.testDir ?? ".");
  return {
    snapshotDir: path.resolve(repoPackage, c.snapshotDir ?? base.snapshotDir ?? c.testDir ?? base.testDir ?? "."),
    ...((c.snapshotPathTemplate ?? base.snapshotPathTemplate)
      ? { snapshotPathTemplate: (c.snapshotPathTemplate ?? base.snapshotPathTemplate).replaceAll("{testDir}", testDir) }
      : {}),
  };
};

// Failure artifacts -- traces, screenshots, error context -- go in the run
// directory, which Please owns, and never beside a config resolved back into
// the repository: unsandboxed, that wrote test-results/ into the checkout.
const outputDir = path.resolve("test-results");

export default defineConfig({
  ...base,
  webServer: undefined,
  globalSetup: PLZ_SETUP,
  outputDir,
  ...snapshots(base),
  use: launch(base.use),
  projects: (base.projects ?? []).map((p) => ({ ...p, outputDir, ...snapshots(p), use: launch(p.use) })),
});
"""


def playwright_test(name:str, srcs:list, serve:str, config:str="playwright.config.ts",
                    config_deps:list=[], deps:list=[], data:list=[], node_modules:str="",
                    browser:str="", project:str="", origin:str="", env:dict={},
                    args:list=[], visibility:list=None, labels:list=[], timeout:int=0,
                    flaky:bool|int=0, size:str=None):
    """Browser tests run by Playwright, against a site Please built.

    The suite runs against `serve` -- the same output vercel_site deploys -- so
    what is tested is the bytes that ship, not a second build. A small static
    server on loopback replaces the config's webServer, so nothing in the test
    needs vite, a dev server or the network.

    The browser is a playwright_browser: hash-pinned, owned by this plugin by
    default, and checked at start against the revision the consumer's
    Playwright expects. Playwright itself comes from the consumer's tree, as
    vite and vitest do. Chrome needs its system libraries (NSS, ATK, X11 and
    so on) on the machine running the test; macOS has them, and a Linux runner
    or remote worker needs them installed.

    Each test is reported to Please by name, via Playwright's JUnit reporter.

    Args:
        name: Target name.
        srcs: The spec files and anything they import that is not a dep.
        serve: The built site to test, e.g. a vite_bundle: one directory.
        config: The Playwright config, relative to this package. Its projects,
                timeouts and retries apply; webServer, baseURL and the browser
                are this rule's.
        config_deps: Anything the config imports.
        deps: js_library and ts_library targets the specs import by name.
        data: Further targets the specs read.
        node_modules: The tree holding @playwright/test.
        browser: A playwright_browser. Defaults to the PlaywrightBrowser config.
        project: Run only this project of the config.
        origin: Serve the site from exactly this loopback origin, e.g.
                "http://localhost:4317", for a backend that admits browsers by
                their Origin. Empty, the default, takes any free port on
                127.0.0.1, which is what lets suites run side by side; a fixed
                port can collide, so set it only where a server demands it.
        env: Environment variables for the run.
        args: Further `playwright test` flags.
        visibility: Visibility specification.
        labels: Additional labels.
        timeout: Test timeout in seconds.
        flaky: True to mark the test flaky, or an integer for reruns.
        size: Test size.
    """
    browser = browser or CONFIG.BUNDLER.PLAYWRIGHT_BROWSER
    if origin:
        scheme, _, rest = origin.partition("://")
        host, _, port = rest.partition(":")
        if scheme != "http" or host not in ["localhost", "127.0.0.1"] or not port or port.lstrip("0123456789"):
            fail(f"playwright_test {name}: origin {origin} is not http://localhost:<port> or " +
                 "http://127.0.0.1:<port>; the site is served on loopback, at a port it names")
    files, config_out = _playwright_files(name, config, serve, browser, origin, update = False)
    return js_test(
        name = name,
        srcs = [config, files] + srcs + config_deps,
        deps = deps,
        data = data + [serve, browser],
        node_modules = node_modules,
        runner = "@playwright/test|playwright",
        env = {"CI": "true", "LANG": "C.UTF-8", "LC_ALL": "C.UTF-8", "TZ": "UTC"} | env,
        runner_env = {"PLAYWRIGHT_JUNIT_OUTPUT_NAME": "$RESULTS_FILE"},
        runner_args = [
            "test",
            "--config", config_out,
            "--reporter=list,junit",
        ] + (["--project", project] if project else []) + args,
        visibility = visibility,
        labels = labels + ["playwright"],
        timeout = timeout,
        flaky = flaky,
        size = size,
    )


# The browser's own process locale and timezone are pinned in playwright_test
# and playwright_update alike. Playwright's locale and timezoneId options reach the
# page's JavaScript, but Chrome still formats a native <input type="date"> from
# the process's LANG: unpinned, `plz test` (a clean environment) and `plz run`
# (the developer's) rendered the same story differently, and a baseline
# recorded by one failed under the other. A literal in each rule rather than a
# shared constant: the build language will not union a frozen dict.


def _playwright_files(name:str, config:str, serve:str, browser:str, origin:str, update:bool):
    """The generated Playwright config and globalSetup, for playwright_test and
    playwright_update: the same config, but an update reads the site and the
    browser where Please built them, and writes snapshots into the
    repository."""
    # Named for the target, so a package can hold several suites -- a gate and
    # a manual one, say -- whose generated files would otherwise collide.
    config_out = f"_pw_{name}_config.ts"
    setup_out = f"_pw_{name}_setup.mjs"
    update_line = ("const PLZ_UPDATE = { site: '$(out_location " + serve + ")', browser: '$(out_location " +
                   browser + ")', pkg: '" + package_name() + "' };") if update else "const PLZ_UPDATE = null;"
    files = genrule(
        name = tag(name, "config"),
        srcs = {"config": [config]},
        deps = [serve, browser] if update else [serve],
        outs = [config_out, setup_out],
        # One line per step under set -e: a heredoc's terminator has to stand
        # alone on its line, which a " && " join would break.
        cmd = "\n".join([
            "set -e",
            'CONFIG_BASE=$(basename "$SRCS_CONFIG" .ts)',
            # The config is imported by its own name, beside it in the run; the
            # site and the browser are repository-relative, so the walk up from
            # the run finds them.
            "{ echo \"import user from './$CONFIG_BASE';\"; echo \"const PLZ_SITE = '$(location " + serve +
            ")';\"; echo \"const PLZ_BROWSER = '" + _playwright_staged(browser) +
            "';\"; echo \"const PLZ_SETUP = './" + setup_out + "';\"; echo \"const PLZ_ORIGIN = '" + origin +
            "';\"; echo \"" + update_line + "\"; cat <<'PLZ_PW'\n" +
            _PLAYWRIGHT_PATHS + "\n" + _PLAYWRIGHT_CONFIG + "\nPLZ_PW\n} > " + config_out,
            "cat > " + setup_out + " <<'PLZ_PW'\n" + _PLAYWRIGHT_SERVER + "\n" + _PLAYWRIGHT_SETUP + "\nPLZ_PW",
        ]),
    )
    return files, config_out


def playwright_update(name:str, srcs:list, serve:str, config:str="playwright.config.ts",
                      config_deps:list=[], deps:list=[], node_modules:str="", browser:str="",
                      project:str="", origin:str="", env:dict={}, args:list=[],
                      visibility:list=None, labels:list=[]):
    """Re-records a Playwright suite's snapshots. `plz run` only.

    The playwright_test of the same suite never writes a snapshot -- it runs in
    CI mode, so a missing or changed one fails -- and this is the one
    sanctioned way they change: the shape of vitest_update, for the same
    reason. A snapshot is a source, reviewed and committed, and a build action
    can touch neither the sources nor the network.

    It runs the suite exactly as the test does -- the same generated config,
    the same staged site, the same pinned browser -- with
    `--update-snapshots`, and every snapshot path the config builds made
    absolute in this package in the repository. So a screenshot recorded here
    is one the test will compare against, taken by the browser the test uses,
    on this platform: a config whose snapshotPathTemplate names {platform}
    keeps each platform's baselines apart.

    Args:
        name: Target name.
        srcs: The same spec files the playwright_test names.
        serve: The same built site.
        config: The same Playwright config.
        config_deps: Anything the config imports.
        deps: js_library and ts_library targets the specs import by name.
        node_modules: The tree holding @playwright/test.
        browser: A playwright_browser. Defaults to the PlaywrightBrowser config.
        project: Re-record only this project of the config.
        origin: As for playwright_test.
        env: Environment variables for the run.
        args: Further `playwright test` flags: a test name filter, most
              usefully. Missing and changed snapshots are written; pass
              `--update-snapshots=all` to rewrite matching ones too.
        visibility: Visibility specification.
        labels: Additional labels.
    """
    # Canonical, so $(out_location) matches the dep it names: inside this
    # plugin's own repository ///bundler// is the repository itself.
    browser = canonicalise(browser or CONFIG.BUNDLER.PLAYWRIGHT_BROWSER)
    files, config_out = _playwright_files(name, config, serve, browser, origin, update = True)
    return js_binary(
        name = name,
        srcs = [config, files] + srcs + config_deps,
        # The site and the browser as deps, so `plz run` builds them first; they
        # are read where Please built them rather than copied into the run.
        deps = deps + [serve, browser],
        node_modules = node_modules,
        runner = "@playwright/test|playwright",
        env = {"CI": "true", "LANG": "C.UTF-8", "LC_ALL": "C.UTF-8", "TZ": "UTC"} | env,
        # Later flags win, so args can widen this to all.
        runner_args = [
            "test",
            "--config", config_out,
            "--reporter=list",
            "--update-snapshots=changed",
        ] + (["--project", project] if project else []) + args,
        visibility = visibility,
        labels = labels + ["playwright_update"],
    )


def playwright_binary(name:str, main:str, srcs:list=[], deps:list=[], node_modules:str="",
                      browser:str="", chdir:str="", check=None, env:dict={},
                      visibility:list=None, labels:list=[]):
    """A program that drives the pinned browser through Playwright. `plz run`
    only.

    For the scripts beside a suite rather than the suite itself: a camera that
    screenshots one story from a running Storybook, say. It launches Chromium
    with Playwright's own API (`chromium.launch()`), and gets the
    playwright_browser playwright_test uses, never one from `playwright
    install`: PLAYWRIGHT_BROWSERS_PATH is exported before node starts. Before,
    not from inside the program: Playwright reads it while its own modules
    load, which an ES module's imports do ahead of any of its code.

    The program is bundled with this plugin's esbuild, its packages left
    external and resolved through the tree, and run from its own package
    directory by default -- where its users run it, so a relative path on its
    command line, or one it reads itself, means what it says.

    Args:
        name: Target name.
        main: The program, relative to this package: .ts, .tsx, .js or .mjs.
        srcs: Further files the program imports.
        deps: js_library and ts_library targets it imports by package name.
        node_modules: The tree holding @playwright/test and its other packages.
        browser: A playwright_browser. Defaults to the PlaywrightBrowser config.
        chdir: Directory to run in, relative to the repository root. Defaults
               to this package.
        check: A ts_check covering the program, as for esbuild_bundle.
               Required when it is TypeScript; False to run it unchecked
               deliberately.
        env: Environment variables for the program.
        visibility: Visibility specification.
        labels: Additional labels.
    """
    # Canonical, so $(out_location) matches the dep it names.
    browser = canonicalise(browser or CONFIG.BUNDLER.PLAYWRIGHT_BROWSER)
    bundle = esbuild_bundle(
        name = tag(name, "bundle"),
        entry_point = main,
        srcs = srcs,
        deps = deps,
        out = f"_{name}_pw.mjs",
        platform = "node",
        format = "esm",
        node_modules = node_modules,
        check = check,
        # Packages resolve at run time, from the tree beside the program:
        # Playwright drives a browser from files of its own, which a bundle
        # would not carry.
        args = ["--packages=external"],
    )
    program = js_binary(
        name = tag(name, "program"),
        entry_point = bundle,
        deps = deps,
        node_modules = node_modules,
        chdir = chdir or package_name(),
        env = env,
    )
    # `plz run` starts a binary in the repository root, which is how the
    # program's own launcher finds its tree; this one finds the browser the
    # same way, by the path Please built it at.
    return build_rule(
        name = name,
        outs = [f"{name}.sh"],
        cmd = "\n".join([
            "cat > $OUT <<'PLZ_PW'",
            "#!/bin/sh",
            "set -eu",
            "ROOT=$(pwd -P)",
            'export PLAYWRIGHT_BROWSERS_PATH="$ROOT/PLZ_BROWSER_OUT"',
            '[ -d "$PLAYWRIGHT_BROWSERS_PATH" ] || { echo "playwright_binary: no browser at $PLAYWRIGHT_BROWSERS_PATH; run it with plz run" >&2; exit 1; }',
            'exec "$ROOT/PLZ_PROGRAM_OUT" "$@"',
            "PLZ_PW",
            "sed -i.bak -e \"s|PLZ_BROWSER_OUT|$(out_location " + browser + ")|\" -e \"s|PLZ_PROGRAM_OUT|$(out_location " + program + ")|\" $OUT",
            "rm -f $OUT.bak && chmod +x $OUT",
        ]),
        binary = True,
        # The program as a build dependency rather than a runtime one: built,
        # and run in place where Please put it, as its own launcher expects.
        # A runtime dependency would be re-inspected on every run, after its
        # launcher has linked the tree into its run directory.
        deps = [browser, program],
        visibility = visibility,
        labels = labels + ["playwright_binary"],
    )


def _playwright_staged(label:str):
    """Where Please stages a data dependency in a test: at its package path,
    with any subrepo prefix dropped -- a target from ///bundler// lands at its
    package within the plugin, as js-rules' _staged_path describes."""
    target = label.split("|")[0].lstrip("/")
    if "//" in target:
        target = target.split("//")[-1]
    package, _, name = target.partition(":")
    return package + "/" + name
